(set-logic QF_NRA)
(set-option :produce-models true)

; The twelve carrier labels are inherited from ../pentagon-offclass-model.
(declare-fun x_u () Real)       (declare-fun y_u () Real)
(declare-fun x_xu () Real)      (declare-fun y_xu () Real)
(declare-fun x_deleted () Real) (declare-fun y_deleted () Real)
(declare-fun x_v () Real)       (declare-fun y_v () Real)
(declare-fun x_xv () Real)      (declare-fun y_xv () Real)
(declare-fun x_c () Real)       (declare-fun y_c () Real)
(declare-fun x_a () Real)       (declare-fun y_a () Real)
(declare-fun x_b () Real)       (declare-fun y_b () Real)
(declare-fun x_e () Real)       (declare-fun y_e () Real)
(declare-fun x_f () Real)       (declare-fun y_f () Real)
(declare-fun x_g () Real)       (declare-fun y_g () Real)
(declare-fun x_h () Real)       (declare-fun y_h () Real)

(define-fun d2 ((ax Real) (ay Real) (bx Real) (by Real)) Real
  (+ (* (- ax bx) (- ax bx)) (* (- ay by) (- ay by))))
(define-fun eqd ((zx Real) (zy Real) (ax Real) (ay Real) (bx Real) (by Real)) Bool
  (= (d2 zx zy ax ay) (d2 zx zy bx by)))
(define-fun turn ((ax Real) (ay Real) (bx Real) (by Real) (cx Real) (cy Real)) Real
  (- (* (- bx ax) (- cy ay)) (* (- by ay) (- cx ax))))
(define-fun proj_u_xu ((px Real) (py Real)) Real
  (+ (* (- px x_u) (- x_xu x_u)) (* (- py y_u) (- y_xu y_u))))

; Gauge: physical apex h=(0,0), rho^2=1, xv=(1,0).
(assert (= x_h 0)) (assert (= y_h 0))
(assert (= x_xv 1)) (assert (= y_xv 0))

; Exact five-point physical circle among these twelve carriers.
(assert (= (d2 x_h y_h x_u y_u) 1))
(assert (= (d2 x_h y_h x_xu y_xu) 1))
(assert (= (d2 x_h y_h x_deleted y_deleted) 1))
(assert (= (d2 x_h y_h x_v y_v) 1))
(assert (= (d2 x_h y_h x_xv y_xv) 1))
(assert (not (= (d2 x_h y_h x_c y_c) 1)))
(assert (not (= (d2 x_h y_h x_a y_a) 1)))
(assert (not (= (d2 x_h y_h x_b y_b) 1)))
(assert (not (= (d2 x_h y_h x_e y_e) 1)))
(assert (not (= (d2 x_h y_h x_f y_f) 1)))
(assert (not (= (d2 x_h y_h x_g y_g) 1)))
(assert (not (= (d2 x_h y_h x_h y_h) 1)))

; Exact row(u), whose actual blocker is xv: {u,xu,e,f}.
(assert (= (d2 x_xv y_xv x_xu y_xu) (d2 x_xv y_xv x_u y_u)))
(assert (= (d2 x_xv y_xv x_e y_e) (d2 x_xv y_xv x_u y_u)))
(assert (= (d2 x_xv y_xv x_f y_f) (d2 x_xv y_xv x_u y_u)))
(assert (not (= (d2 x_xv y_xv x_deleted y_deleted) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_v y_v) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_xv y_xv) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_c y_c) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_a y_a) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_b y_b) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_g y_g) (d2 x_xv y_xv x_u y_u))))
(assert (not (= (d2 x_xv y_xv x_h y_h) (d2 x_xv y_xv x_u y_u))))

; Exact row(xv), whose off-class actual blocker is c: {u,xv,a,b}.
(assert (= (d2 x_c y_c x_xv y_xv) (d2 x_c y_c x_u y_u)))
(assert (= (d2 x_c y_c x_a y_a) (d2 x_c y_c x_u y_u)))
(assert (= (d2 x_c y_c x_b y_b) (d2 x_c y_c x_u y_u)))
(assert (not (= (d2 x_c y_c x_xu y_xu) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_deleted y_deleted) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_v y_v) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_c y_c) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_e y_e) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_f y_f) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_g y_g) (d2 x_c y_c x_u y_u))))
(assert (not (= (d2 x_c y_c x_h y_h) (d2 x_c y_c x_u y_u))))

; Proposed exact carrier-bisector API from the deep-thinker response.
(assert (eqd x_h y_h x_u y_u x_xu y_xu))
(assert (eqd x_xv y_xv x_u y_u x_xu y_xu))
(assert (not (eqd x_u y_u x_u y_u x_xu y_xu)))
(assert (not (eqd x_xu y_xu x_u y_u x_xu y_xu)))
(assert (not (eqd x_deleted y_deleted x_u y_u x_xu y_xu)))
(assert (not (eqd x_v y_v x_u y_u x_xu y_xu)))
(assert (not (eqd x_c y_c x_u y_u x_xu y_xu)))
(assert (not (eqd x_a y_a x_u y_u x_xu y_xu)))
(assert (not (eqd x_b y_b x_u y_u x_xu y_xu)))
(assert (not (eqd x_e y_e x_u y_u x_xu y_xu)))
(assert (not (eqd x_f y_f x_u y_u x_xu y_xu)))
(assert (not (eqd x_g y_g x_u y_u x_xu y_xu)))

(assert (eqd x_h y_h x_u y_u x_xv y_xv))
(assert (eqd x_c y_c x_u y_u x_xv y_xv))
(assert (not (eqd x_u y_u x_u y_u x_xv y_xv)))
(assert (not (eqd x_xu y_xu x_u y_u x_xv y_xv)))
(assert (not (eqd x_deleted y_deleted x_u y_u x_xv y_xv)))
(assert (not (eqd x_v y_v x_u y_u x_xv y_xv)))
(assert (not (eqd x_xv y_xv x_u y_u x_xv y_xv)))
(assert (not (eqd x_a y_a x_u y_u x_xv y_xv)))
(assert (not (eqd x_b y_b x_u y_u x_xv y_xv)))
(assert (not (eqd x_e y_e x_u y_u x_xv y_xv)))
(assert (not (eqd x_f y_f x_u y_u x_xv y_xv)))
(assert (not (eqd x_g y_g x_u y_u x_xv y_xv)))

; One orientation of the proposed forced order and local signed convexity.
(assert (< (proj_u_xu x_u y_u) (proj_u_xu x_c y_c)))
(assert (< (proj_u_xu x_c y_c) (proj_u_xu x_xv y_xv)))
(assert (< (proj_u_xu x_xv y_xv) (proj_u_xu x_xu y_xu)))
(assert (< (turn x_u y_u x_c y_c x_xv y_xv) 0))
(assert (< (turn x_c y_c x_xv y_xv x_xu y_xu) 0))

; Exact-card-12 specialization: all twelve named carrier points are distinct.
(assert (> (d2 x_u y_u x_xu y_xu) 0))
(assert (> (d2 x_u y_u x_deleted y_deleted) 0))
(assert (> (d2 x_u y_u x_v y_v) 0))
(assert (> (d2 x_u y_u x_xv y_xv) 0))
(assert (> (d2 x_u y_u x_c y_c) 0))
(assert (> (d2 x_u y_u x_a y_a) 0))
(assert (> (d2 x_u y_u x_b y_b) 0))
(assert (> (d2 x_u y_u x_e y_e) 0))
(assert (> (d2 x_u y_u x_f y_f) 0))
(assert (> (d2 x_u y_u x_g y_g) 0))
(assert (> (d2 x_u y_u x_h y_h) 0))
(assert (> (d2 x_xu y_xu x_deleted y_deleted) 0))
(assert (> (d2 x_xu y_xu x_v y_v) 0))
(assert (> (d2 x_xu y_xu x_xv y_xv) 0))
(assert (> (d2 x_xu y_xu x_c y_c) 0))
(assert (> (d2 x_xu y_xu x_a y_a) 0))
(assert (> (d2 x_xu y_xu x_b y_b) 0))
(assert (> (d2 x_xu y_xu x_e y_e) 0))
(assert (> (d2 x_xu y_xu x_f y_f) 0))
(assert (> (d2 x_xu y_xu x_g y_g) 0))
(assert (> (d2 x_xu y_xu x_h y_h) 0))
(assert (> (d2 x_deleted y_deleted x_v y_v) 0))
(assert (> (d2 x_deleted y_deleted x_xv y_xv) 0))
(assert (> (d2 x_deleted y_deleted x_c y_c) 0))
(assert (> (d2 x_deleted y_deleted x_a y_a) 0))
(assert (> (d2 x_deleted y_deleted x_b y_b) 0))
(assert (> (d2 x_deleted y_deleted x_e y_e) 0))
(assert (> (d2 x_deleted y_deleted x_f y_f) 0))
(assert (> (d2 x_deleted y_deleted x_g y_g) 0))
(assert (> (d2 x_deleted y_deleted x_h y_h) 0))
(assert (> (d2 x_v y_v x_xv y_xv) 0))
(assert (> (d2 x_v y_v x_c y_c) 0))
(assert (> (d2 x_v y_v x_a y_a) 0))
(assert (> (d2 x_v y_v x_b y_b) 0))
(assert (> (d2 x_v y_v x_e y_e) 0))
(assert (> (d2 x_v y_v x_f y_f) 0))
(assert (> (d2 x_v y_v x_g y_g) 0))
(assert (> (d2 x_v y_v x_h y_h) 0))
(assert (> (d2 x_xv y_xv x_c y_c) 0))
(assert (> (d2 x_xv y_xv x_a y_a) 0))
(assert (> (d2 x_xv y_xv x_b y_b) 0))
(assert (> (d2 x_xv y_xv x_e y_e) 0))
(assert (> (d2 x_xv y_xv x_f y_f) 0))
(assert (> (d2 x_xv y_xv x_g y_g) 0))
(assert (> (d2 x_xv y_xv x_h y_h) 0))
(assert (> (d2 x_c y_c x_a y_a) 0))
(assert (> (d2 x_c y_c x_b y_b) 0))
(assert (> (d2 x_c y_c x_e y_e) 0))
(assert (> (d2 x_c y_c x_f y_f) 0))
(assert (> (d2 x_c y_c x_g y_g) 0))
(assert (> (d2 x_c y_c x_h y_h) 0))
(assert (> (d2 x_a y_a x_b y_b) 0))
(assert (> (d2 x_a y_a x_e y_e) 0))
(assert (> (d2 x_a y_a x_f y_f) 0))
(assert (> (d2 x_a y_a x_g y_g) 0))
(assert (> (d2 x_a y_a x_h y_h) 0))
(assert (> (d2 x_b y_b x_e y_e) 0))
(assert (> (d2 x_b y_b x_f y_f) 0))
(assert (> (d2 x_b y_b x_g y_g) 0))
(assert (> (d2 x_b y_b x_h y_h) 0))
(assert (> (d2 x_e y_e x_f y_f) 0))
(assert (> (d2 x_e y_e x_g y_g) 0))
(assert (> (d2 x_e y_e x_h y_h) 0))
(assert (> (d2 x_f y_f x_g y_g) 0))
(assert (> (d2 x_f y_f x_h y_h) 0))
(assert (> (d2 x_g y_g x_h y_h) 0))

(check-sat)
