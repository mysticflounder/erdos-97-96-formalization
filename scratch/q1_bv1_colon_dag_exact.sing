LIB "elim.lib";
ring B=0,(br,bs,bu,bv,bw),dp;
poly e2=br^2*bs^3-br^2*bs^2*bu-br^2*bs^2*bv+br^2*bs*bu*bv-br*bs^3*bu+br*bs^2*bu^2+br*bs^2*bu*bv-br*bs*bu^2*bv-br*bs*bu^2*bw+br*bs*bu*bw^2+br*bs*bv^2*bw+br*bu^2*bv*bw-br*bu*bv^2*bw-br*bu*bv*bw^2-bs*bv^2*bw^2+bu*bv^2*bw^2;
poly e5=br^2*bs^3-br^2*bs^2*bu-br^2*bs^2*bv+br^2*bs*bu*bv+br^2*bs*bu-br^2*bu*bv-br*bs^3+br*bs^2*bu+br*bs^2*bv-br*bs*bu^2-br*bs*bu*bv+br*bu^2*bv+bs*bu*bv^2-bs*bv^2-bu^2*bv^2+bu*bv^2;
poly e7=bs^3*bu-bs^3-bs^2*bu^2-bs^2*bu*bv+bs^2*bu+bs^2*bv+bs*bu^2*bv+bs*bu*bv-bs*bu-bs*bv^2-bu^2*bv+bu*bv;
poly e8=bs^2*bv*bw-bs^2*bw^2+bs^2*bw-bs^2-bs*bv^2*bw+bs*bv*bw^2-bs*bv*bw+bs*bv+bv^2*bw-bv*bw;
poly e9=br^2*bv+br*bs^2*bv-br*bs^2-br*bs*bv^2+br*bs*bv-br*bv^2-br*bv+bv^3;
poly q1=bs^3-2*bs^2*bu-bs^2*bw+bs*bu^2+bs*bu*bw+bs*bw^2-bu^2*bw;
ideal H=e2,e5,e7,e8,e9,q1;
ideal Q1=std(quotient(H,ideal(bw)));
ideal Q2=std(quotient(Q1,ideal(bw)));
ideal Q3=std(quotient(Q2,ideal(bw)));
poly target=bv^2*(bv-1)^2;
matrix S3[1][size(Q3)]; matrix S2[1][size(Q2)]; matrix S1[1][size(Q1)];
matrix C3=lift(Q3,ideal(target)); int i; int j; int total=0; int nodes=0;
for(i=1;i<=nrows(C3);i++){if(C3[i,1]!=0){S3[1,i]=1; total=total+size(C3[i,1]); nodes++;}}
print("Q sizes="+string(size(Q1))+","+string(size(Q2))+","+string(size(Q3))+" target support="+string(nodes)+" terms="+string(total));
total=0; nodes=0;
for(i=1;i<=size(Q3);i++){if(S3[1,i]!=0){matrix C2=lift(Q2,ideal(bw*Q3[i])); for(j=1;j<=nrows(C2);j++){if(C2[j,1]!=0){S2[1,j]=1; total=total+size(C2[j,1]);}} nodes++;}}
print("stage Q3->Q2 nodes="+string(nodes)+" coeffterms="+string(total));
total=0; nodes=0;
for(i=1;i<=size(Q2);i++){if(S2[1,i]!=0){matrix C1=lift(Q1,ideal(bw*Q2[i])); for(j=1;j<=nrows(C1);j++){if(C1[j,1]!=0){S1[1,j]=1; total=total+size(C1[j,1]);}} nodes++;}}
print("stage Q2->Q1 nodes="+string(nodes)+" coeffterms="+string(total));
total=0; nodes=0; int hsupp=0; int chars=0; int maxchars=0;
for(i=1;i<=size(Q1);i++){if(S1[1,i]!=0){matrix C0=lift(H,ideal(bw*Q1[i])); int nodeterms=0; int nodechars=0; int nodemaxchars=0; for(j=1;j<=nrows(C0);j++){if(C0[j,1]!=0){int cc=size(string(C0[j,1])); hsupp++; total=total+size(C0[j,1]); nodeterms=nodeterms+size(C0[j,1]); chars=chars+cc; nodechars=nodechars+cc; if(cc>maxchars){maxchars=cc;} if(cc>nodemaxchars){nodemaxchars=cc;} write("scratch/q1_colon_q1_lifts_v1.expr","Q1="+string(i)+" H="+string(j)+" C="+string(C0[j,1]));}} print("bottom Q1="+string(i)+" terms="+string(nodeterms)+" chars="+string(nodechars)+" maxcoeffchars="+string(nodemaxchars)); nodes++;}}
print("stage Q1->H nodes="+string(nodes)+" coeffterms="+string(total)+" nonzero H slots="+string(hsupp));
print("stage Q1->H coefficient chars="+string(chars)+" maxcoeffchars="+string(maxchars));
print("supports Q3/Q2/Q1:");
for(i=1;i<=size(Q3);i++){if(S3[1,i]!=0){print("Q3 "+string(i)+" terms="+string(size(Q3[i]))+" deg="+string(deg(Q3[i]))+" p="+string(Q3[i]));}}
for(i=1;i<=size(Q2);i++){if(S2[1,i]!=0){print("Q2 "+string(i)+" terms="+string(size(Q2[i]))+" deg="+string(deg(Q2[i]))+" p="+string(Q2[i]));}}
for(i=1;i<=size(Q1);i++){if(S1[1,i]!=0){print("Q1 "+string(i)+" terms="+string(size(Q1[i]))+" deg="+string(deg(Q1[i]))+" p="+string(Q1[i]));}}
quit;
