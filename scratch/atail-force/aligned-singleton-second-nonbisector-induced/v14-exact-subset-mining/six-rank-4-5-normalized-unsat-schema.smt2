(set-logic QF_NRA)
(declare-fun t () Real)
(declare-fun v () Real)
(declare-fun u () Real)
(define-fun Q () Real (- (* t u) 1))
(define-fun P () Real (+ (* t u) (* t v) (- (* u v)) 1))
(define-fun R () Real (+ (* t u v) (- t) u v))
(define-fun A () Real (+ (* t v) (- t) v 1))
(define-fun B () Real (+ (* t v) t (- v) 1))
(assert (> t 0))
(assert (> v t))
(assert (> (* 2 t Q P) 0))
(assert (> (* P R) 0))
(assert (> (* (- t v) A B) 0))
(check-sat)
