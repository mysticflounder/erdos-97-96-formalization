(set-logic QF_NRA)
(declare-fun t () Real)
(declare-fun v () Real)
(declare-fun L () Real)
(declare-fun A () Real)
(declare-fun F () Real)
(assert (> t 0))
(assert (> v t))
(assert (> L 0))
(assert (< (+ (* v A) L) 0))
(assert (> F 0))
(assert (= F (+ (- (* A A)) (* 2 t A) (- (* L L)))))
(check-sat)
