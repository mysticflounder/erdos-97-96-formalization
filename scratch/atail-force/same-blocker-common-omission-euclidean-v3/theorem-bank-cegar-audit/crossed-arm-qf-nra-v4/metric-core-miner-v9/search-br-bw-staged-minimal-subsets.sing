ring B=0,(br,bs,bu,bv,bw),dp;
LIB "modstd.lib";
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6); ideal L; ideal BSI=std(bs); ideal BWI=std(bw);
poly p; int k;
for(k=1;k<=size(K);k++)
{
  p=K[k]; while(p!=0 and reduce(p,BSI)==0){p=p/bs;} while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
  if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e2=subst(L[2],br,bw); poly e5=subst(L[5],br,bw); poly e7=subst(L[7]/br,br,bw);
poly e8=subst(L[8]/(br*(bv-1)),br,bw); poly e9=subst(L[9]/(bv-1),br,bw);
ideal J=e2,e5,e7,e8,e9;
poly t1=bs*(bv-bu)*(bw-1)*(bw-bv);
poly t2=bs*bv*(bw^3-bv^2+2*bv*bw-3*bw^2+bw);
int mask; int j; ideal S; ideal G;
for(mask=1;mask<32;mask++)
{
  S=0;
  for(j=1;j<=5;j++){if(mask div (2^(j-1)) mod 2){S[size(S)+1]=J[j];}}
  G=modStd(S,1);
  if(reduce(t1,G)==0){print("B3 mask="+string(mask)+" size="+string(size(S)));}
  if(reduce(t2,G)==0){print("B17 mask="+string(mask)+" size="+string(size(S)));}
}
quit;
