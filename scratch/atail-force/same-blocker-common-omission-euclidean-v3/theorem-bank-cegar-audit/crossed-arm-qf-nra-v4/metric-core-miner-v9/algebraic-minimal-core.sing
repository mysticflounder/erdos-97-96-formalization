ring R=0,(x_r2,x_s3,x_t1,x_t2,x_t4,y_r2,y_s3,y_t1,y_t2,y_t4),dp;
ideal I=x_r2^2 - 2*x_r2*x_t4 - x_s3^2 + 2*x_s3*x_t4 + y_r2^2 - 2*y_r2*y_t4 - y_s3^2 + 2*y_s3*y_t4,x_r2^2 - 2*x_r2*x_t4 - x_t1^2 + 2*x_t1*x_t4 + y_r2^2 - 2*y_r2*y_t4 - y_t1^2 + 2*y_t1*y_t4,-x_s3^2 - y_s3^2 + 1,-x_t4^2 - y_t4^2 + 1,-x_s3^2 + 2*x_s3*x_t1 - x_t1^2 - y_s3^2 + 2*y_s3*y_t1 - y_t1^2 + 1,-x_s3^2 + 2*x_s3*x_t2 - x_t2^2 - y_s3^2 + 2*y_s3*y_t2 - y_t2^2 + 1,x_r2^2 - x_t2^2 + y_r2^2 - y_t2^2,x_t2^2 - 2*x_t2 - x_t4^2 + 2*x_t4 + y_t2^2 - y_t4^2,-x_r2^2 + 2*x_r2*x_t2 - 2*x_t2 - y_r2^2 + 2*y_r2*y_t2 + 1,2*x_r2*x_t1 - 2*x_r2 - x_t1^2 + 2*y_r2*y_t1 - y_t1^2 + 1,2*x_t1*x_t2 - 2*x_t1 - x_t2^2 + 2*y_t1*y_t2 - y_t2^2 + 1;
ideal G=std(I);
if(size(G)==1 and G[1]==1){print("UNIT");}else{print("NONUNIT");}
quit;
