ring C=0,(zr,zs,zu,zv,zw,br,bs,bu,bv,bw),dp;
ideal I=(zr-zw)*(br-bw)-(zs-zw)*(bs-bw),(zr-zw)*(br-bw)-(zu-zw)*(bu-bw),1-zs*bs,1-zw*bw,1-(zs-zu)*(bs-bu),1-(zs-zv)*(bs-bv),zr*br-zv*bv,(zv-1)*(bv-1)-(zw-1)*(bw-1),(zv-zr)*(bv-br)-(zv-1)*(bv-1),(zr-zu)*(br-bu)-(zr-1)*(br-1),(zu-zv)*(bu-bv)-(zu-1)*(bu-1);
ideal J,G;
int branch,k,mask,j,n,tmp,found;
for(branch=1;branch<=2;branch++)
{
  found=0;
  for(k=1;k<=11;k++)
  {
    for(mask=1;mask<2048;mask++)
    {
      n=0; tmp=mask;
      for(j=1;j<=11;j++){n=n+(tmp%2);tmp=tmp div 2;}
      if(n==k)
      {
        if(branch==1){J=br,zr;}else{J=bv-1,zv-1;}
        tmp=mask;
        for(j=1;j<=11;j++){if(tmp%2==1){J[size(J)+1]=I[j];}tmp=tmp div 2;}
        G=std(J);
        if(size(G)==1 and G[1]!=0)
        {
          print("branch="+string(branch)+" min_count="+string(k)+" mask="+string(mask));
          tmp=mask;
          for(j=1;j<=11;j++){if(tmp%2==1){print("uses f"+string(j));}tmp=tmp div 2;}
          found=1;break;
        }
      }
    }
    if(found==1){break;}
  }
}
quit;
