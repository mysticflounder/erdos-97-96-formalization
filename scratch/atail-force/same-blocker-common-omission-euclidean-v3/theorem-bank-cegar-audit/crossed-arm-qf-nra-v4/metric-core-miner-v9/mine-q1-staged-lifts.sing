ring B=0,(br,bs,bu,bv,bw),dp;
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6); ideal L; ideal BSI=std(bs); ideal BWI=std(bw); poly p; int k;
for(k=1;k<=size(K);k++)
{
 p=K[k]; while(p!=0 and reduce(p,BSI)==0){p=p/bs;} while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
 if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e1=L[1]; poly e2=L[2]; poly e5=L[5]; poly e7=L[7]/br; poly e8=L[8]/(br*(bv-1)); poly e9=L[9]/(bv-1); poly q1=e1/(bv*(br-bw));
ideal H=e2,e5,e7,e8,e9,q1;
matrix T; ideal U=liftstd(H,T);
ideal J;
for(k=1;k<=size(U);k++){if(k!=3){J[size(J)+1]=U[k];}}
poly G3=br*bs*bv*bw-br*bu*bv*bw-bs*bv^2*bw+bu*bv^2*bw;
poly G7=br^2*bs*bv-br*bs*bv^2+bs*bv^3-br*bs*bv;
poly G39=br^2*bu^2*bw-br^2*bs*bw^2-br*bu^2*bw+br*bs*bw^2;
proc report(matrix C,poly target,string label,string filename)
{
 poly reconstructed=0; int total=0; int md=0; int j;
 int cleanup=system("sh","rm -f "+filename);
 for(j=1;j<=nrows(C);j++)
 {
  reconstructed=reconstructed+C[j,1]*J[j]; total=total+size(C[j,1]);
  if(C[j,1]!=0 and deg(C[j,1])>md){md=deg(C[j,1]);}
  write(filename,string(C[j,1]));
 }
 print(label+" identity="+string(reconstructed==target)+" terms="+string(total)+" maxdeg="+string(md));
}
print("INTERMEDIATES");
int j; int idx;
for(idx=8;idx<=37;idx++)
{
 if(idx==8 or idx==24 or idx==30 or idx==32 or idx==34 or idx==37)
 {
  int total=0; int md=0;
  for(j=1;j<=nrows(T);j++){total=total+size(T[j,idx]); if(T[j,idx]!=0 and deg(T[j,idx])>md){md=deg(T[j,idx]);}}
  print("U"+string(idx)+" terms="+string(size(U[idx]))+" degree="+string(deg(U[idx]))+" certterms="+string(total)+" certdeg="+string(md)+" poly="+string(U[idx]));
 }
}
matrix C3=lift(J,ideal(G3)); report(C3,G3,"G3","q1-G3-via-other-gb.singexpr");
quit;
