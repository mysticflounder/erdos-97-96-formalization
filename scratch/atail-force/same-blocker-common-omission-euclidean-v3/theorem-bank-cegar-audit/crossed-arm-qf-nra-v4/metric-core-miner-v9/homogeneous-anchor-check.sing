ring R=0,(p_x,p_y,x_r2,x_s3,x_t1,x_t2,x_t4,y_r2,y_s3,y_t1,y_t2,y_t4),dp;
poly q=p_x^2+p_y^2;
ideal I=
  x_r2^2 - 2*x_r2*x_t4 - x_s3^2 + 2*x_s3*x_t4 + y_r2^2 - 2*y_r2*y_t4 - y_s3^2 + 2*y_s3*y_t4,
  x_r2^2 - 2*x_r2*x_t4 - x_t1^2 + 2*x_t1*x_t4 + y_r2^2 - 2*y_r2*y_t4 - y_t1^2 + 2*y_t1*y_t4,
  q-x_s3^2-y_s3^2,
  q-x_t4^2-y_t4^2,
  q-x_s3^2+2*x_s3*x_t1-x_t1^2-y_s3^2+2*y_s3*y_t1-y_t1^2,
  q-x_s3^2+2*x_s3*x_t2-x_t2^2-y_s3^2+2*y_s3*y_t2-y_t2^2,
  x_r2^2-x_t2^2+y_r2^2-y_t2^2,
  x_t2^2-x_t4^2+y_t2^2-y_t4^2-2*p_x*x_t2+2*p_x*x_t4-2*p_y*y_t2+2*p_y*y_t4,
  q-x_r2^2-y_r2^2-2*p_x*x_t2-2*p_y*y_t2+2*x_r2*x_t2+2*y_r2*y_t2,
  q-2*p_x*x_r2-2*p_y*y_r2+2*x_r2*x_t1+2*y_r2*y_t1-x_t1^2-y_t1^2,
  q-2*p_x*x_t1-2*p_y*y_t1+2*x_t1*x_t2+2*y_t1*y_t2-x_t2^2-y_t2^2;

ideal G=std(I);
print("GB_SIZE="+string(size(G)));
int k;
for (k=1; k<=12; k=k+1) {
  poly r=reduce(q^k,G);
  print("POWER="+string(k)+" REMAINDER_IS_ZERO="+string(r==0));
  if (r==0) { break; }
}
quit;
