ring R=0,(bv,bs,bw,x,y),dp;
poly e2=-bs^3*bv*bw + bs^3*bv*x - bs^3*bw*y + bs^3*x*y + bs^2*bv^2*bw - 2*bs^2*bv^2*x + bs^2*bv*bw^2 - 2*bs^2*bv*bw*x + bs^2*bv*bw*y + bs^2*bv*x^2 - 3*bs^2*bv*x*y + bs^2*bw^2*y - 2*bs^2*bw*x*y + bs^2*x^2*y - bs^2*x*y^2 + bs*bv^3*x - bs*bv^2*bw^2 + 2*bs*bv^2*bw*x - bs*bv^2*x^2 + 2*bs*bv^2*x*y + bs*bv*bw^2*x - bs*bv*bw^2*y - bs*bv*bw*x^2 + 2*bs*bv*bw*x*y - bs*bv*x^2*y + bs*bv*x*y^2 + bs*bw^2*x*y - bs*bw*x^2*y - bv^3*bw*x + bv^2*bw*x^2 - bv^2*bw*x*y - bv*bw^2*x*y + bv*bw*x^2*y;
poly e5=-bs^3*bv - bs^3*y - bs^2*bv^2*x + 2*bs^2*bv^2 - 2*bs^2*bv*x*y - bs^2*bv*x + 3*bs^2*bv*y - bs^2*x*y^2 - bs^2*x*y + bs^2*y^2 + bs*bv^3*x - bs*bv^3 + 2*bs*bv^2*x*y + bs*bv^2*x - 2*bs*bv^2*y - bs*bv*x^2 + bs*bv*x*y^2 + 3*bs*bv*x*y - bs*bv*y^2 - bs*x^2*y + bs*x*y^2 - bv^3*x - 2*bv^2*x*y + bv^2*x + bv*x^2*y - bv*x*y^2;
poly e7=-bs^3*x + bs^2*bv*x + bs^2*bv - bs^2*x^2 + bs^2*x - bs^2 - bs*bv^2 + bs*bv*x^2 - bs*bv*x + bs*bv - bs*x - bv*x^2 + bv*x;
poly e8=-bs^2*bv*bw + bs^2*bw^2 - bs^2*bw + bs^2 + bs*bv^2*bw - bs*bv*bw^2 + bs*bv*bw - bs*bv - bv^2*bw + bv*bw;
poly e9=bs^2*bv^2 + bs^2*bv*y - bs^2*bv - bs^2*y - bs*bv^3 - bs*bv^2*y + bs*bv^2 + bs*bv*y + bv^3 + bv^2*y - bv^2 + bv*y^2 - bv*y;
poly q1=-bs^2*bw + bs*bw^2 - bs*bw*x + bs*x^2 - bw*x^2;
poly P=x*y*bv*bw;
poly D1,D2,D3,D4,D5,D6;
execute(read("localized-g3-product-square-certificate-exact-v1.singexpr"));
poly check=D1*e2+D2*e5+D3*e7+D4*e8+D5*e9+D6*q1-P^2;
print("INDEPENDENT_SQUARE_IDENTITY="+string(check==0));
print("RESIDUAL_TERMS="+string(size(check)));
print("D1_TERMS="+string(size(D1))+" DEG="+string(deg(D1)));
print("D2_TERMS="+string(size(D2))+" DEG="+string(deg(D2)));
print("D3_TERMS="+string(size(D3))+" DEG="+string(deg(D3)));
print("D4_TERMS="+string(size(D4))+" DEG="+string(deg(D4)));
print("D5_TERMS="+string(size(D5))+" DEG="+string(deg(D5)));
print("D6_TERMS="+string(size(D6))+" DEG="+string(deg(D6)));
quit;
