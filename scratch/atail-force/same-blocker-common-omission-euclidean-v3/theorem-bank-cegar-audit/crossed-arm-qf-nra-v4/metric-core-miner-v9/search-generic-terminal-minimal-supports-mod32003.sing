ring B=32003,(br,bs,bu,bv,bw),dp;
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6);
ideal L;
ideal BSI=std(bs);
ideal BWI=std(bw);
poly p;
int k;
for(k=1;k<=size(K);k++)
{
  p=K[k];
  while(p!=0 and reduce(p,BSI)==0){p=p/bs;}
  while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
  if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e1=L[1];
poly e2=L[2];
poly e5=L[5];
poly e7=L[7]/br;
poly e8=L[8]/(br*(bv-1));
poly e9=L[9]/(bv-1);
poly q1=e1/(bv*(br-bw));

proc minSupport(ideal I,poly target,string label)
{
  ideal J,G;
  int k,mask,j,n,tmp;
  int found=0;
  for(k=1;k<=size(I);k++)
  {
    for(mask=1;mask<2^size(I);mask++)
    {
      n=0;tmp=mask;
      for(j=1;j<=size(I);j++){n=n+(tmp%2);tmp=tmp div 2;}
      if(n==k)
      {
        J=0;tmp=mask;
        for(j=1;j<=size(I);j++){if(tmp%2==1){J[size(J)+1]=I[j];}tmp=tmp div 2;}
        G=std(J);
        if(reduce(target,G)==0)
        {
          print(label+" count="+string(k)+" mask="+string(mask));
          tmp=mask;
          for(j=1;j<=size(I);j++){if(tmp%2==1){print("uses h"+string(j));}tmp=tmp div 2;}
          found=1;break;
        }
      }
    }
    if(found==1){break;}
  }
}

ideal H0=e2,e5,e7,e8,e9,bv;
ideal Hbw=e2,e5,e7,e8,e9,br-bw;
ideal Hq=e2,e5,e7,e8,e9,q1;
minSupport(H0,br*bs^2,"bv=0");
minSupport(Hbw,bs^3*bw*(bv-1)^3,"br=bw");
minSupport(Hq,br*bs^2*bw^2*(bv-1)^2,"q1=0");
poly gA=(bu-bs)*(br-bv)*bv*bw;
poly gF=bs*bv*(br^2-br*bv+bv^2-br);
poly gB=br*(br-1)*bw*(bs*bw-bu^2);
minSupport(Hq,gA,"gA");
minSupport(Hq,gF,"gF");
minSupport(Hq,gB,"gB");
quit;
