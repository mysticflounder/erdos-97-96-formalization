ring B=0,(br,bs,bu,bv,bw),dp;
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6);
ideal L;
ideal BSI=std(bs);
ideal BWI=std(bw);
poly p;
int k;
for(k=1;k<=size(K);k++)
{
  p=K[k];
  while(p!=0 and reduce(p,BSI)==0){p=p/bs;}
  while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
  if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e1=L[1];
poly e2=L[2];
poly e5=L[5];
poly e7=L[7]/br;
poly e8=L[8]/(br*(bv-1));
poly e9=L[9]/(bv-1);
poly q1=e1/(bv*(br-bw));

proc searchProduct(ideal J,string label)
{
  ideal G=std(J);
  int total,a,b,c,d;
  int found=0;
  poly candidate;
  for(total=0;total<=16;total++)
  {
    for(a=0;a<=total;a++)
    {
      for(b=0;b<=total-a;b++)
      {
        for(c=0;c<=total-a-b;c++)
        {
          d=total-a-b-c;
          candidate=br^a*bs^b*bw^c*(bv-1)^d;
          if(reduce(candidate,G)==0)
          {
            print(label+" product="+string(candidate)+" total_degree="+string(total)+" gb_size="+string(size(G)));
            found=1;break;
          }
        }
        if(found==1){break;}
      }
      if(found==1){break;}
    }
    if(found==1){break;}
  }
  if(found==0){print(label+" NO_PRODUCT_UP_TO_16 gb_size="+string(size(G)));}
}

ideal H0=e2,e5,e7,e8,e9,bv;
ideal Hbw=e2,e5,e7,e8,e9,br-bw;
ideal Hq=e2,e5,e7,e8,e9,q1;
searchProduct(H0,"bv=0");
searchProduct(Hbw,"br=bw");
searchProduct(Hq,"q1=0");
quit;
