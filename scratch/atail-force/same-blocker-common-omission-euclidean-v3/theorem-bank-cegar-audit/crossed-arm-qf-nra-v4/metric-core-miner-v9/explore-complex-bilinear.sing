ring C=(0,i),(zr,zs,zu,zv,zw,br,bs,bu,bv,bw),dp;
minpoly=i^2+1;
poly f1=(zr-zw)*(br-bw)-(zs-zw)*(bs-bw);
poly f2=(zr-zw)*(br-bw)-(zu-zw)*(bu-bw);
poly f3=1-zs*bs;
poly f4=1-zw*bw;
poly f5=1-(zs-zu)*(bs-bu);
poly f6=1-(zs-zv)*(bs-bv);
poly f7=zr*br-zv*bv;
poly f8=(zv-1)*(bv-1)-(zw-1)*(bw-1);
poly f9=(zv-zr)*(bv-br)-(zv-1)*(bv-1);
poly f10=(zr-zu)*(br-bu)-(zr-1)*(br-1);
poly f11=(zu-zv)*(bu-bv)-(zu-1)*(bu-1);
ideal I=f1,f2,f3,f4,f5,f6,f7,f8,f9,f10,f11;
option(redSB);
matrix T;
ideal G=liftstd(I,T);
print("GB_SIZE="+string(size(G)));
print("G1="+string(G[1]));
int j;
int total=0;
int maxdeg=0;
for(j=1;j<=nrows(T);j++) { total=total+size(T[j,1]); if(deg(T[j,1])>maxdeg){maxdeg=deg(T[j,1]);} print("row "+string(j)+" terms="+string(size(T[j,1]))+" deg="+string(deg(T[j,1]))); }
print("TOTAL="+string(total)+" MAXDEG="+string(maxdeg));
quit;
