ring B=0,(br,bs,bu,bv,bw),dp;
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6); ideal L; ideal BSI=std(bs); ideal BWI=std(bw); poly p; int k;
for(k=1;k<=size(K);k++)
{
 p=K[k]; while(p!=0 and reduce(p,BSI)==0){p=p/bs;} while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
 if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e1=L[1]; poly e2=L[2]; poly e5=L[5]; poly e7=L[7]/br; poly e8=L[8]/(br*(bv-1)); poly e9=L[9]/(bv-1); poly q1=e1/(bv*(br-bw));
ideal H=e2,e5,e7,e8,e9,q1;
matrix T;
ideal U=liftstd(H,T);
print("LIFTSTD_SIZE="+string(size(U))+" TROWS="+string(nrows(T))+" TCOLS="+string(ncols(T)));
int j; int total; int md;
for(k=1;k<=size(U);k++)
{
  if(size(U[k])<=12)
  {
    total=0; md=0;
    for(j=1;j<=nrows(T);j++){total=total+size(T[j,k]); if(T[j,k]!=0 and deg(T[j,k])>md){md=deg(T[j,k]);}}
    print("U"+string(k)+" terms="+string(size(U[k]))+" degree="+string(deg(U[k]))+" certterms="+string(total)+" certdeg="+string(md)+" poly="+string(U[k]));
    print(factorize(U[k]));
  }
}
quit;
