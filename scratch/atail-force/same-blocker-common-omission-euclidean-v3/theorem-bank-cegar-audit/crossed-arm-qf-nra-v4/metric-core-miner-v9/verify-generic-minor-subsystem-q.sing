ring B=0,(br,bs,bu,bv,bw,t),dp;
LIB "modstd.lib";
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6);
ideal L;
ideal BSI=std(bs);
ideal BWI=std(bw);
poly p;
int k;
for(k=1;k<=size(K);k++)
{
  p=K[k];
  while(p!=0 and reduce(p,BSI)==0){p=p/bs;}
  while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
  if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
ideal H=L[1],L[2],L[5],L[7],L[8],L[9],t*br*bs*bw*(bv-1)-1;
ideal G=modStd(H,1);
print("UNIT="+string(size(G)==1 and G[1]!=0));
print("SELECTED_MINOR_COUNT=6");
quit;
