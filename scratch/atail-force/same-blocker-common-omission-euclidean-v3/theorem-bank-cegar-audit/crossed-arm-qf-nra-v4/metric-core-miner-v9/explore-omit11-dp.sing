ring R=0,(r,s,u,v,w,Ry,Sy,Uy,Vy,Wy),dp;
poly f1=r^2-2*r*w-s^2+2*s*w+Ry^2-2*Ry*Wy-Sy^2+2*Sy*Wy;
poly f2=r^2-2*r*w-u^2+2*u*w+Ry^2-2*Ry*Wy-Uy^2+2*Uy*Wy;
poly f3=-s^2-Sy^2+1;
poly f4=-w^2-Wy^2+1;
poly f5=-s^2+2*s*u-u^2-Sy^2+2*Sy*Uy-Uy^2+1;
poly f6=-s^2+2*s*v-v^2-Sy^2+2*Sy*Vy-Vy^2+1;
poly f7=r^2-v^2+Ry^2-Vy^2;
poly f8=v^2-2*v-w^2+2*w+Vy^2-Wy^2;
poly f9=-r^2+2*r*v-2*v-Ry^2+2*Ry*Vy+1;
poly f10=2*r*u-2*r-u^2+2*Ry*Uy-Uy^2+1;
ideal J=f1,f2,f3,f4,f5,f6,f7,f8,f9,f10;
ideal G=std(J);
print("dim="+string(dim(G))+" size="+string(size(G))+" vdim="+string(vdim(G)));
int i;
for(i=1;i<=size(G);i++) { if(size(G[i])<=8 and deg(G[i])<=4) { print(string(i)+" t="+string(size(G[i]))+" d="+string(deg(G[i]))+" :: "+string(G[i])); } }
quit;
