          (+ (^ (- r1_x a1_x) 2.0) (^ (- r1_y a1_y) 2.0))))
(assert (= (+ (^ (- p1_x r1_x) 2.0) (^ (- p1_y r1_y) 2.0))
   (+ (^ (- p1_x t1_x) 2.0) (^ (- p1_y t1_y) 2.0))))
(assert (= (+ (^ (- p1_x r2_x) 2.0) (^ (- p1_y r2_y) 2.0))
   (+ (^ (- p1_x t1_x) 2.0) (^ (- p1_y t1_y) 2.0))))
(assert (= (+ (^ (- p1_x a3_x) 2.0) (^ (- p1_y a3_y) 2.0))
   (+ (^ (- p1_x t1_x) 2.0) (^ (- p1_y t1_y) 2.0))))
(assert (distinct (+ (^ (- p1_x a1_x) 2.0) (^ (- p1_y a1_y) 2.0))
          (+ (^ (- p1_x t1_x) 2.0) (^ (- p1_y t1_y) 2.0))))
(assert (distinct (+ (^ (- p1_x t3_x) 2.0) (^ (- p1_y t3_y) 2.0))
          (+ (^ (- p1_x t1_x) 2.0) (^ (- p1_y t1_y) 2.0))))
(assert (distinct (+ (^ (- p1_x q1_x) 2.0) (^ (- p1_y q1_y) 2.0))
          (+ (^ (- p1_x t1_x) 2.0) (^ (- p1_y t1_y) 2.0))))
(assert (distinct (+ (^ (- p1_x p2_x) 2.0) (^ (- p1_y p2_y) 2.0))
