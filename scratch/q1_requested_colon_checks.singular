ring R=0,(br,bs,bu,bv,bw),dp;
poly q1=bs^3-2*bs^2*bu-bs^2*bw+bs*bu^2+bs*bu*bw+bs*bw^2-bu^2*bw;
poly e2=br^2*bs^3-br^2*bs^2*bu-br^2*bs^2*bv+br^2*bs*bu*bv-br*bs^3*bu+br*bs^2*bu^2+br*bs^2*bu*bv-br*bs*bu^2*bv-br*bs*bu^2*bw+br*bs*bu*bw^2+br*bs*bv^2*bw+br*bu^2*bv*bw-br*bu*bv^2*bw-br*bu*bv*bw^2-bs*bv^2*bw^2+bu*bv^2*bw^2;
poly e5=br^2*bs^3-br^2*bs^2*bu-br^2*bs^2*bv+br^2*bs*bu*bv+br^2*bs*bu-br^2*bu*bv-br*bs^3+br*bs^2*bu+br*bs^2*bv-br*bs*bu^2-br*bs*bu*bv+br*bu^2*bv+bs*bu*bv^2-bs*bv^2-bu^2*bv^2+bu*bv^2;
poly e7=bs^3*bu-bs^3-bs^2*bu^2-bs^2*bu*bv+bs^2*bu+bs^2*bv+bs*bu^2*bv+bs*bu*bv-bs*bu-bs*bv^2-bu^2*bv+bu*bv;
poly e8=bs^2*bv*bw-bs^2*bw^2+bs^2*bw-bs^2-bs*bv^2*bw+bs*bv*bw^2-bs*bv*bw+bs*bv+bv^2*bw-bv*bw;
poly e9=br^2*bv+br*bs^2*bv-br*bs^2-br*bs*bv^2+br*bs*bv-br*bv^2-br*bv+bv^3;
ideal H=e2,e5,e7,e8,e9,q1; ideal Q1=std(quotient(H,ideal(bw))); ideal Q2=std(quotient(Q1,ideal(bw))); ideal Q3=std(quotient(Q2,ideal(bw)));
poly t1=br*bs^2*bw*(bv-1)^2; poly t2=br*bs^2*(bv-1)^2; poly t3=br*bs^2*bw^2*(bv-1)^2;
print("Q1_T1="+string(reduce(t1,Q1))+" ZERO="+string(reduce(t1,Q1)==0));
print("Q2_T2="+string(reduce(t2,Q2))+" ZERO="+string(reduce(t2,Q2)==0));
print("Q3_T3="+string(reduce(t3,Q3))+" ZERO="+string(reduce(t3,Q3)==0));
matrix C1=lift(Q1,ideal(t1)); int i; int nz=0; int total=0;
for(i=1;i<=nrows(C1);i++){if(C1[i,1]!=0){nz++; total=total+size(C1[i,1]); print("Q1ROW "+string(i)+" P="+string(Q1[i])+" C="+string(C1[i,1]));}}
print("Q1_LIFT_NZ="+string(nz)+" TERMS="+string(total));
for(i=1;i<=nrows(C1);i++){if(C1[i,1]!=0){matrix C0=lift(H,ideal(bw*Q1[i])); int j; for(j=1;j<=nrows(C0);j++){if(C0[j,1]!=0){print("HROW Q1="+string(i)+" H="+string(j)+" C="+string(C0[j,1]));}}}}
quit;
