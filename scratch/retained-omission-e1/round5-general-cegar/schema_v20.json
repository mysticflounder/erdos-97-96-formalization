{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema_v20.json",
  "title": "Retained-omission v20 disjoint cube-wave artifacts",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/child"},
    {"$ref": "#/$defs/aggregate"}
  ],
  "$defs": {
    "literal": {
      "type": "object",
      "required": ["bool", "value"],
      "properties": {
        "bool": {"type": "string", "minLength": 1},
        "value": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "cube": {
      "type": "object",
      "required": ["cube_id", "index", "assignment", "assignment_sha256"],
      "properties": {
        "cube_id": {"type": "string", "pattern": "^cube-[0-9]{3}-[0-9a-f]{12}$"},
        "index": {"type": "integer", "minimum": 0},
        "assignment": {"type": "array", "items": {"$ref": "#/$defs/literal"}},
        "assignment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema_version", "kind", "case_id", "split_bools", "cube_count",
        "partition_exhaustive", "partition_pairwise_disjoint", "cubes",
        "terminal_v19", "admission", "script_sha256", "schema_sha256",
        "runner_sha256", "focused_test_source_sha256", "design_note_sha256",
        "base_v19_script_sha256", "base_v19_schema_sha256", "manifest_sha256"
      ],
      "properties": {
        "schema_version": {"const": 20},
        "kind": {"const": "v20-disjoint-cube-wave"},
        "case_id": {"const": "fresh_DDD_k0_d2_f1"},
        "split_bools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "cube_count": {"type": "integer", "minimum": 2},
        "partition_exhaustive": {"const": true},
        "partition_pairwise_disjoint": {"const": true},
        "cubes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/cube"}},
        "terminal_v19": {"type": "object"},
        "terminal_proposal_joint_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "empirical_counts_are_soundness_inputs": {"const": false},
        "admission": {"type": "object"},
        "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "focused_test_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "design_note_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_v19_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_v19_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "child": {
      "type": "object",
      "required": [
        "schema_version", "kind", "manifest_sha256", "cube_id", "status",
        "complete", "cube_assignment", "cube_assignment_sha256",
        "raw_full_formula_sha256", "v19_terminal_summary_sha256",
        "imported_full_blocker_count", "imported_full_blockers_sha256",
        "master_only_admission", "inherited_result"
      ],
      "properties": {
        "schema_version": {"const": 20},
        "kind": {"const": "v20-cube-child"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cube_id": {"type": "string"},
        "cube_assignment": {"type": "array", "items": {"$ref": "#/$defs/literal"}},
        "cube_assignment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["sat", "unsat", "unknown", "budget", "error"]},
        "complete": {"type": "boolean"},
        "reason_incomplete": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "raw_full_formula_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "v19_terminal_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "imported_full_blocker_count": {"type": "integer"},
        "imported_full_blockers_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "master_only_admission": {"type": "object"},
        "inherited_result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "required": [
        "schema_version", "kind", "manifest_sha256", "case_id", "status",
        "complete", "conditional_unsat", "declared_cube_count",
        "closed_unsat_cube_count", "missing_cube_ids", "unresolved_cubes",
        "sat_cube_ids", "authenticated_children", "closure_rule"
      ],
      "properties": {
        "schema_version": {"const": 20},
        "kind": {"const": "v20-cube-wave-aggregate"},
        "manifest_sha256": {"type": "string"},
        "case_id": {"const": "fresh_DDD_k0_d2_f1"},
        "status": {"enum": ["sat", "unsat", "unknown"]},
        "complete": {"type": "boolean"},
        "conditional_unsat": {"type": "boolean"},
        "declared_cube_count": {"type": "integer"},
        "closed_unsat_cube_count": {"type": "integer"},
        "missing_cube_ids": {"type": "array", "items": {"type": "string"}},
        "unresolved_cubes": {"type": "array", "items": {"type": "object"}},
        "sat_cube_ids": {"type": "array", "items": {"type": "string"}},
        "authenticated_children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cube_id", "status", "complete", "cube_result_sha256",
              "child_attestation_sha256", "authenticated_evidence_sha256",
              "authenticated_evidence"
            ],
            "properties": {
              "cube_id": {"type": "string"},
              "status": {"enum": ["sat", "unsat", "unknown", "budget", "error"]},
              "complete": {"type": "boolean"},
              "cube_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "child_attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "authenticated_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "authenticated_evidence": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "closure_rule": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
