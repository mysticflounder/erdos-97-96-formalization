ring B=32003,(br,bs,bu,bv,bw),dp;
poly e2=br^2*bs^3-br^2*bs^2*bu-br^2*bs^2*bv+br^2*bs*bu*bv-br*bs^3*bu+br*bs^2*bu^2+br*bs^2*bu*bv-br*bs*bu^2*bv-br*bs*bu^2*bw+br*bs*bu*bw^2+br*bs*bv^2*bw+br*bu^2*bv*bw-br*bu*bv^2*bw-br*bu*bv*bw^2-bs*bv^2*bw^2+bu*bv^2*bw^2;
poly e5=br^2*bs^3-br^2*bs^2*bu-br^2*bs^2*bv+br^2*bs*bu*bv+br^2*bs*bu-br^2*bu*bv-br*bs^3+br*bs^2*bu+br*bs^2*bv-br*bs*bu^2-br*bs*bu*bv+br*bu^2*bv+bs*bu*bv^2-bs*bv^2-bu^2*bv^2+bu*bv^2;
poly e7=bs^3*bu-bs^3-bs^2*bu^2-bs^2*bu*bv+bs^2*bu+bs^2*bv+bs*bu^2*bv+bs*bu*bv-bs*bu-bs*bv^2-bu^2*bv+bu*bv;
poly e8=bs^2*bv*bw-bs^2*bw^2+bs^2*bw-bs^2-bs*bv^2*bw+bs*bv*bw^2-bs*bv*bw+bs*bv+bv^2*bw-bv*bw;
poly e9=br^2*bv+br*bs^2*bv-br*bs^2-br*bs*bv^2+br*bs*bv-br*bv^2-br*bv+bv^3;
poly q1=bs^3-2*bs^2*bu-bs^2*bw+bs*bu^2+bs*bu*bw+bs*bw^2-bu^2*bw;
ideal H=e2,e5,e7,e8,e9,q1;

proc addUnique(list L, int a)
{
  int i;
  for(i=1;i<=size(L);i++){if(L[i]==a){return(L);}}
  L[size(L)+1]=a;
  return(L);
}

proc assess(string label, list M)
{
  list Is; Is[1]=H;
  int k; int i; int j; int total; int alltotal=0;
  for(k=1;k<=5;k++){ideal Prev=Is[k]; poly x=M[k]; ideal Next=std(quotient(Prev,ideal(x))); Is[k+1]=Next;}
  ideal Last=Is[6]; poly target=(bv-1)^2;
  matrix C=lift(Last,ideal(target)); list act;
  for(i=1;i<=nrows(C);i++){if(C[i,1]!=0){act=addUnique(act,i);}}
  string report=label+" sizes";
  for(k=1;k<=6;k++){ideal Show=Is[k]; report=report+" "+string(size(Show));}
  report=report+" supports "+string(size(act));
  for(k=5;k>=1;k--)
  {
    ideal Curr=Is[k+1]; ideal Prev2=Is[k]; poly x2=M[k];
    list nextact; total=0;
    for(i=1;i<=size(act);i++)
    {
      matrix D=lift(Prev2,ideal(x2*Curr[act[i]]));
      for(j=1;j<=nrows(D);j++){if(D[j,1]!=0){nextact=addUnique(nextact,j); total=total+size(D[j,1]);}}
    }
    report=report+" | "+string(size(act))+":"+string(total)+":"+string(size(nextact));
    alltotal=alltotal+total; act=nextact;
  }
  print(report+" total="+string(alltotal));
}

list a1=bv,bv,bw,bw,bw; assess("vvwww",a1);
list a2=bv,bw,bv,bw,bw; assess("vwvww",a2);
list a3=bv,bw,bw,bv,bw; assess("vwwvw",a3);
list a4=bv,bw,bw,bw,bv; assess("vwwwv",a4);
list a5=bw,bv,bv,bw,bw; assess("wvvww",a5);
list a6=bw,bv,bw,bv,bw; assess("wvwvw",a6);
list a7=bw,bv,bw,bw,bv; assess("wvwwv",a7);
list a8=bw,bw,bv,bv,bw; assess("wwvvw",a8);
list a9=bw,bw,bv,bw,bv; assess("wwvwv",a9);
list a10=bw,bw,bw,bv,bv; assess("wwwvv",a10);
quit;
