                      Pρ.source₁ ∉ (H.selectedAt P.source₁ ⋯).support ∧
                          Pρ.source₂ ∉ (H.selectedAt P.source₁ ⋯).support ∧
                            P.source₁ ∉ (H.selectedAt Pρ.source₁ ⋯).support ∧
                              P.source₂ ∉ (H.selectedAt Pρ.source₁ ⋯).support ∧
                                ((H.selectedAt P.source₁ ⋯).support \ S.capByIndex S.oppIndex1).card = 2 ∧
                                  ((H.selectedAt Pρ.source₁ ⋯).support \ S.capByIndex S.oppIndex1).card = 2 →
                        ∀ (LPρ : Problem97.ATailRetainedStrictInteriorPairSelector.LocalizedCollisionCommonDeletion P),
                          LPρ.fresh = Pρ.source₁ →
                            ∀
                              (MPρ :
                                Problem97.ATailLocalizedCollisionMutualOmissionCycle.LocalizedCollisionMutualOmissionCycle
                                  P LPρ)
                              (LP :
                                Problem97.ATailRetainedStrictInteriorPairSelector.LocalizedCollisionCommonDeletion Pρ),
                              LP.fresh = P.source₁ →
                                ∀
                                  (MP :
