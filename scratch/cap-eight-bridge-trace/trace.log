@Problem97.ATailFrontierLiveClosure.exists_three_hit_or_collision_crossHit_of_two_sourceExactCollisionRows : ∀
  {D : Problem97.CounterexampleData} {S : Problem97.SurplusCapPacket D.A} {radius ρ : ℝ}
  {H : Problem97.CriticalShellSystem D.A} {F : Problem97.ATailCriticalPairFrontier.CriticalPairFrontier D S radius H}
  {R : Problem97.ATailOrientedPhysicalApexIngress.FrontierCommonDeletionParentResidual F}
  (P : Problem97.ATailRetainedStrictInteriorPairSelector.RetainedInteriorBlockerCollision R)
  {Fρ : Problem97.ATailCriticalPairFrontier.CriticalPairFrontier D S ρ H}
  {Rρ : Problem97.ATailOrientedPhysicalApexIngress.FrontierCommonDeletionParentResidual Fρ}
  (Pρ : Problem97.ATailRetainedStrictInteriorPairSelector.RetainedInteriorBlockerCollision Rρ),
  ρ ≠ radius →
    (Problem97.SelectedClass D.A S.oppApex1 radius).card = 4 →
      (Problem97.SelectedClass D.A S.oppApex1 ρ).card = 4 →
        Problem97.SelectedClass D.A S.oppApex1 radius ∩ S.capInteriorByIndex S.oppIndex1 = {P.source₁, P.source₂} →
          Problem97.SelectedClass D.A S.oppApex1 ρ ∩ S.capInteriorByIndex S.oppIndex1 = {Pρ.source₁, Pρ.source₂} →
            ∀ {B : Problem97.ATailPhysicalSecondApexCommonDeletion.FrontierBiApexRobustResidual R}
              {L : Problem97.ATailLargeOppositeCapsBiApexSurface.FrontierLargeOppositeCapsBiApexRobustResidual B}
              {N : Problem97.ATailFrontierLiveClosure.FrontierAllLargeCapsBiApexRobustResidual L},
              Problem97.ATailFrontierLiveClosure.FrontierAllLargeCapsTriApexRobustResidual N →
                (∀ (x : EuclideanSpace ℝ (Fin 2)) (hx : x ∈ D.A),
                    H.centerAt x hx ≠ x ∧
                      Problem97.ATailMinimalUniqueFourCover.IsUniqueFourCenter D.A (H.centerAt x hx) ∧
                        Problem97.ATailMinimalUniqueFourCover.uniqueFourClass D.A (H.centerAt x hx) =
                          (H.selectedAt x hx).support) →
                  Disjoint {P.source₁, P.source₂} {Pρ.source₁, Pρ.source₂} →
                    H.centerAt Pρ.source₁ ⋯ ≠ H.centerAt P.source₁ ⋯ →
                      ∀ (LPρ : Problem97.ATailRetainedStrictInteriorPairSelector.LocalizedCollisionCommonDeletion P),
                        LPρ.fresh = Pρ.source₁ →
                          ∀
                            (MPρ :
                              Problem97.ATailLocalizedCollisionMutualOmissionCycle.LocalizedCollisionMutualOmissionCycle
                                P LPρ)
                            (LP :
                              Problem97.ATailRetainedStrictInteriorPairSelector.LocalizedCollisionCommonDeletion Pρ),
                            LP.fresh = P.source₁ →
                              ∀
                                (MP :
                                  Problem97.ATailLocalizedCollisionMutualOmissionCycle.LocalizedCollisionMutualOmissionCycle
                                    Pρ LP),
                                8 ≤ (S.capByIndex S.oppIndex1).card ∨
                                    H.centerAt P.source₁ ⋯ = Pρ.source₁ ∨
                                      H.centerAt P.source₁ ⋯ = Pρ.source₂ ∨
                                        H.centerAt Pρ.source₁ ⋯ = P.source₁ ∨ H.centerAt Pρ.source₁ ⋯ = P.source₂ →
                                  (∃ i x,
                                      ∃ (hx : x ∈ D.A),
                                        ∃ r,
                                          Problem97.ATailApexRichClassStructure.ApexRichClassStructure D.A
                                              (S.oppositeVertexByIndex i) ∧
                                            3 ≤
                                              ((H.selectedAt x hx).support ∩
                                                  (Problem97.SelectedClass D.A (S.oppositeVertexByIndex i) r ∩
                                                    S.capInteriorByIndex i)).card) ∨
                                    Pρ.source₁ ∈ (H.selectedAt P.source₁ ⋯).support ∨
                                      Pρ.source₂ ∈ (H.selectedAt P.source₁ ⋯).support ∨
                                        P.source₁ ∈ (H.selectedAt Pρ.source₁ ⋯).support ∨
                                          P.source₂ ∈ (H.selectedAt Pρ.source₁ ⋯).support
