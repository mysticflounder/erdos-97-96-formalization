ring B=0,(br,bs,bu,bv,bw),dp;
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6); ideal L; ideal BSI=std(bs); ideal BWI=std(bw); poly p; int k;
for(k=1;k<=size(K);k++)
{
 p=K[k]; while(p!=0 and reduce(p,BSI)==0){p=p/bs;} while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
 if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e2=L[2]; poly e5=L[5]; poly e7=L[7]/br; poly e8=L[8]/(br*(bv-1)); poly e9=L[9]/(bv-1); poly q1=L[1]/(bv*(br-bw));
ideal H=e2,e5,e7,e8,e9,q1;
matrix T; ideal U=liftstd(H,T);
poly G3=br*bs*bv*bw-br*bu*bv*bw-bs*bv^2*bw+bu*bv^2*bw;
// The selected U indices have small certificates to H; test their ideal closure.
ideal Iall=U[1],U[2],U[6],U[8],U[24],U[30],U[32],U[34],U[37];
print("ALL9 reduce="+string(reduce(G3,std(Iall))==0)+" size="+string(size(Iall)));
intvec ids=1,2,6,8,24,30,32,34,37;
int mask; int cnt; ideal It; poly r;
for(cnt=8;cnt>=1;cnt--)
{
 for(mask=1;mask<512;mask++)
 {
  int cntbits=0; int bit=mask;
  while(bit>0){cntbits=cntbits+(bit mod 2); bit=bit div 2;}
  if(cntbits==cnt)
  {
   ideal It; int j;
   for(j=1;j<=9;j++){if((mask div (2^(j-1))) mod 2==1){It[size(It)+1]=U[ids[j]];}}
   r=reduce(G3,std(It));
   if(r==0){print("FOUND cnt="+string(cnt)+" mask="+string(mask)); quit;}
  }
 }
}
print("NO_SUBSET");
quit;
