+    ∃ gap : Fin 10,
+      0 < gap ∧ gap < 9 ∧
+      a = gap.succAbove (1 : Fin 9) ∧
+      b = gap.succAbove (2 : Fin 9) ∧
+      c = gap.succAbove (3 : Fin 9) ∧
+      d = gap.succAbove (4 : Fin 9) ∧
+      e = gap.succAbove (5 : Fin 9) ∧
