+private theorem seven_strict_interior_indices_ten
+    (a b c d e f g : Fin 10)
+    (ha : 0 < a) (hab : a < b) (hbc : b < c) (hcd : c < d)
+    (hde : d < e) (hef : e < f) (hfg : f < g)
