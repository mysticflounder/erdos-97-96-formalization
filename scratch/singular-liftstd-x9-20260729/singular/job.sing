ring r=0,(x2x,x2y,x3x,x3y,x4x,x4y,x5x,x5y,x6x,x6y,x7x,x7y,x8x,x8y,x9x,x9y),dp;
ideal I=((0-x3x)^2+(0-x3y)^2)-((0-x4x)^2+(0-x4y)^2),
  ((0-x3x)^2+(0-x3y)^2)-((0-x5x)^2+(0-x5y)^2),
  ((0-x3x)^2+(0-x3y)^2)-((0-x9x)^2+(0-x9y)^2),
  ((1-x2x)^2+(0-x2y)^2)-((1-x4x)^2+(0-x4y)^2),
  ((1-x2x)^2+(0-x2y)^2)-((1-x7x)^2+(0-x7y)^2),
  ((1-x2x)^2+(0-x2y)^2)-((1-x8x)^2+(0-x8y)^2),
  ((x2x-0)^2+(x2y-0)^2)-((x2x-1)^2+(x2y-0)^2),
  ((x2x-0)^2+(x2y-0)^2)-((x2x-x4x)^2+(x2y-x4y)^2),
  ((x2x-0)^2+(x2y-0)^2)-((x2x-x9x)^2+(x2y-x9y)^2),
  ((x3x-0)^2+(x3y-0)^2)-((x3x-x6x)^2+(x3y-x6y)^2),
  ((x3x-0)^2+(x3y-0)^2)-((x3x-x7x)^2+(x3y-x7y)^2),
  ((x3x-0)^2+(x3y-0)^2)-((x3x-x9x)^2+(x3y-x9y)^2),
  ((x4x-0)^2+(x4y-0)^2)-((x4x-1)^2+(x4y-0)^2),
  ((x4x-0)^2+(x4y-0)^2)-((x4x-x2x)^2+(x4y-x2y)^2),
  ((x4x-0)^2+(x4y-0)^2)-((x4x-x7x)^2+(x4y-x7y)^2),
  ((x5x-0)^2+(x5y-0)^2)-((x5x-x4x)^2+(x5y-x4y)^2),
  ((x5x-0)^2+(x5y-0)^2)-((x5x-x6x)^2+(x5y-x6y)^2),
  ((x5x-0)^2+(x5y-0)^2)-((x5x-x8x)^2+(x5y-x8y)^2),
  ((x6x-x3x)^2+(x6y-x3y)^2)-((x6x-x5x)^2+(x6y-x5y)^2),
  ((x6x-x3x)^2+(x6y-x3y)^2)-((x6x-x7x)^2+(x6y-x7y)^2),
  ((x6x-x3x)^2+(x6y-x3y)^2)-((x6x-x8x)^2+(x6y-x8y)^2),
  ((x7x-1)^2+(x7y-0)^2)-((x7x-x3x)^2+(x7y-x3y)^2),
  ((x7x-1)^2+(x7y-0)^2)-((x7x-x4x)^2+(x7y-x4y)^2),
  ((x7x-1)^2+(x7y-0)^2)-((x7x-x6x)^2+(x7y-x6y)^2),
  ((x8x-1)^2+(x8y-0)^2)-((x8x-x5x)^2+(x8y-x5y)^2),
  ((x8x-1)^2+(x8y-0)^2)-((x8x-x6x)^2+(x8y-x6y)^2),
  ((x8x-1)^2+(x8y-0)^2)-((x8x-x9x)^2+(x8y-x9y)^2),
  ((x9x-0)^2+(x9y-0)^2)-((x9x-x2x)^2+(x9y-x2y)^2),
  ((x9x-0)^2+(x9y-0)^2)-((x9x-x3x)^2+(x9y-x3y)^2),
  ((x9x-0)^2+(x9y-0)^2)-((x9x-x8x)^2+(x9y-x8y)^2);
matrix T;
ideal G=liftstd(I,T,"slimgb");
poly target=x9x^2+x9y^2;
poly nf=reduce(target,G);
print("NORMAL_FORM_BEGIN");
string(nf);
print("NORMAL_FORM_END");
if (nf!=0) { print("TARGET_NOT_IN_IDEAL"); quit; }
ideal J=target;
matrix U;
matrix K=lift(G,J,U,"slimgb");
matrix C=T*K;
poly identity=0;
for (int i=1;i<=size(I);i++) { identity=identity+I[i]*C[i,1]; }
print("IDENTITY_BEGIN");
string(identity);
print("IDENTITY_END");
