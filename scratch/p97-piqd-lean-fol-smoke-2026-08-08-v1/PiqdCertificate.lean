/-- Parse one DIMACS clause body (signed ints terminated by 0).
Subtracts 1 from each var so DIMACS 1-indexing maps to Lean's
0-indexed `CNF Nat`; `CNF.convertLRAT` adds the +1 back. -/
def parseDimacsClause (line : String) : List (Nat × Bool) :=
  (line.splitOn " ").filterMap fun tok =>
    match tok.trimAscii.toInt? with
    | some 0 => none
    | some n => some (n.natAbs - 1, decide (n > 0))
    | none => none

/-- Parse a DIMACS-format CNF (`c` comments, `p cnf v c` header, then clauses). -/
def parseDimacs (s : String) : CNF Nat :=
