+    (hfirstBlockerNeV :
+      (lateFirstApexSystem R).centerAt
+          first.deleted.1 first.deleted.2 ≠
+        (lateFirstApexSystem R).centerAt v.1 v.2)
+    (hfirstBlockerNeApex :
+      (lateFirstApexSystem R).centerAt
+          first.deleted.1 first.deleted.2 ≠ S.oppApex2)
