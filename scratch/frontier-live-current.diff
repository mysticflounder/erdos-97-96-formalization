+        dist packet.xv P.u.1 = dist P.u.1 packet.xv := dist_comm _ _
+        _ = dist P.u.1 packet.xu := huxu_eq_uxv.symm
+        _ = dist packet.xu packet.xv := huxu_eq_xuxv
+        _ = dist packet.xv packet.xu := dist_comm _ _
