+      (hphysicalU.trans hphysicalXv.symm)
+      hinnerU hinnerXu hinnerXv
+  have happA : S.oppApex2 ∈ D.A :=
+    P.surface.ingress.packet.center₂_mem_A
+  have hneU : S.oppApex2 ≠ P.u.1 := by
+    intro h
