option(redSB);
// Shift bu = bs + x; target is x^8*bv^2*bw.
ring R=0,(br,x,bs,bv,bw),dp;
poly q1=bs^3-2*bs^2*(bs+x)-bs^2*bw+bs*(bs+x)^2+bs*(bs+x)*bw+bs*bw^2-(bs+x)^2*bw;
poly e2=br^2*bs^3-br^2*bs^2*(bs+x)-br^2*bs^2*bv+br^2*bs*(bs+x)*bv-br*bs^3*(bs+x)+br*bs^2*(bs+x)^2+br*bs^2*(bs+x)*bv-br*bs*(bs+x)^2*bv-br*bs*(bs+x)^2*bw+br*bs*(bs+x)*bw^2+br*bs*bv^2*bw+br*(bs+x)^2*bv*bw-br*(bs+x)*bv^2*bw-br*(bs+x)*bv*bw^2-bs*bv^2*bw^2+(bs+x)*bv^2*bw^2;
poly e5=br^2*bs^3-br^2*bs^2*(bs+x)-br^2*bs^2*bv+br^2*bs*(bs+x)*bv+br^2*bs*(bs+x)-br^2*(bs+x)*bv-br*bs^3+br*bs^2*(bs+x)+br*bs^2*bv-br*bs*(bs+x)^2-br*bs*(bs+x)*bv+br*(bs+x)^2*bv+bs*(bs+x)*bv^2-bs*bv^2-(bs+x)^2*bv^2+(bs+x)*bv^2;
poly e7=bs^3*(bs+x)-bs^3-bs^2*(bs+x)^2-bs^2*(bs+x)*bv+bs^2*(bs+x)+bs^2*bv+bs*(bs+x)^2*bv+bs*(bs+x)*bv-bs*(bs+x)-bs*bv^2-(bs+x)^2*bv+(bs+x)*bv;
poly e8=bs^2*bv*bw-bs^2*bw^2+bs^2*bw-bs^2-bs*bv^2*bw+bs*bv*bw^2-bs*bv*bw+bs*bv+bv^2*bw-bv*bw;
poly e9=br^2*bv+br*bs^2*bv-br*bs^2-br*bs*bv^2+br*bs*bv-br*bv^2-br*bv+bv^3;
ideal H=e2,e5,e7,e8,e9,q1;

ideal G=std(H);
poly target=x^8*bv^2*bw;
poly rem=reduce(target,G);
print("ORDER_BASIS_SIZE="+string(size(G))+" ORDER_REM_ZERO="+string(rem==0));
matrix C=lift(G,ideal(target));
int i; int nz=0; int total=0; int mx=0;
for(i=1;i<=nrows(C);i++){if(C[i,1]!=0){int t=size(C[i,1]);nz=nz+1;total=total+t;if(t>mx){mx=t;}}}
print("ORDER_LIFT_NZ="+string(nz)+" ORDER_LIFT_TERMS="+string(total)+" ORDER_LIFT_MAXTERMS="+string(mx));
for(i=1;i<=nrows(C);i++){if(C[i,1]!=0){print("CROW "+string(i)+" CTERMS="+string(size(C[i,1]))+" G="+string(G[i])+" C="+string(C[i,1]));}}
quit;
