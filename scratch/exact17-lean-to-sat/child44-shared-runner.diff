+def _open_directory_nofollow(path: Path, *, create: bool) -> int:
+    """Open a directory through descriptor-relative, no-symlink traversal."""
+    absolute = Path(os.path.abspath(path))
+    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
+    descriptor = os.open(os.path.sep, flags)
+    try:
+        for component in absolute.parts[1:]:
+            if create:
+                try:
+                    os.mkdir(component, 0o700, dir_fd=descriptor)
+                except FileExistsError:
+                    pass
+            next_descriptor = os.open(component, flags, dir_fd=descriptor)
+            os.close(descriptor)
+            descriptor = next_descriptor
+        _require(stat.S_ISDIR(os.fstat(descriptor).st_mode), f"not a directory: {path}")
+        return descriptor
+    except BaseException:
+        os.close(descriptor)
+        raise
+
+
+def _open_regular_nofollow(path: Path) -> int:
+    directory = _open_directory_nofollow(path.parent, create=False)
+    try:
+        descriptor = os.open(
+            path.name,
+            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
+            dir_fd=directory,
+        )
+    finally:
+        os.close(directory)
+    try:
+        _require(stat.S_ISREG(os.fstat(descriptor).st_mode), f"not a regular file: {path}")
+    except BaseException:
+        os.close(descriptor)
+        raise
+    return descriptor
+
+
+def _path_entry_exists_nofollow(path: Path) -> bool:
+    """Test for a directory entry without following it or any ancestor symlink."""
+    try:
+        directory = _open_directory_nofollow(path.parent, create=False)
+    except FileNotFoundError:
+        return False
+    try:
+        try:
+            os.stat(path.name, dir_fd=directory, follow_symlinks=False)
+        except FileNotFoundError:
+            return False
+        return True
+    finally:
+        os.close(directory)
+
+
+def _strict_json_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def _read_json_record_nofollow(path: Path) -> tuple[dict[str, Any], str]:
+    """Read and hash one lifecycle record from the same no-follow descriptor."""
+    descriptor = _open_regular_nofollow(path)
+    try:
+        before = os.fstat(descriptor)
+        size = before.st_size
+        chunks: list[bytes] = []
+        offset = 0
+        while offset < size:
+            chunk = os.pread(descriptor, min(1024 * 1024, size - offset), offset)
+            if not chunk:
+                raise ValueError(f"lifecycle record truncated while reading: {path}")
+            chunks.append(chunk)
+            offset += len(chunk)
+        after = os.fstat(descriptor)
+        _require(
+            (
+                before.st_dev,
+                before.st_ino,
+                before.st_size,
+                before.st_mtime_ns,
+                before.st_ctime_ns,
+            )
+            == (
+                after.st_dev,
+                after.st_ino,
+                after.st_size,
+                after.st_mtime_ns,
+                after.st_ctime_ns,
+            ),
+            f"lifecycle record changed while reading: {path}",
+        )
+    finally:
+        os.close(descriptor)
+    rendered = b"".join(chunks)
+    value = json.loads(rendered.decode("utf-8"), object_pairs_hook=_strict_json_object)
+    if not isinstance(value, dict):
+        raise TypeError(f"expected JSON object: {path}")
+    return value, hashlib.sha256(rendered).hexdigest()
+
+
+def _attest_regular_nofollow(
+    path: Path,
+    *,
+    expected_sha256: str,
+    expected_bytes: int | None = None,
+    expected_prefix: bytes | None = None,
+) -> dict[str, Any]:
+    """Hash and inspect one immutable input through a single held descriptor."""
+    descriptor = _open_regular_nofollow(path)
+    try:
+        before = os.fstat(descriptor)
+        digest = hashlib.sha256()
+        prefix = b""
+        offset = 0
+        while offset < before.st_size:
+            chunk = os.pread(
+                descriptor,
+                min(1024 * 1024, before.st_size - offset),
+                offset,
+            )
+            if not chunk:
+                raise ValueError(f"regular file truncated while attesting: {path}")
+            digest.update(chunk)
+            if expected_prefix is not None and len(prefix) < len(expected_prefix):
+                prefix += chunk[: len(expected_prefix) - len(prefix)]
+            offset += len(chunk)
+        after = os.fstat(descriptor)
+        _require(
+            (
+                before.st_dev,
+                before.st_ino,
+                before.st_size,
+                before.st_mtime_ns,
+                before.st_ctime_ns,
+            )
+            == (
+                after.st_dev,
+                after.st_ino,
+                after.st_size,
+                after.st_mtime_ns,
+                after.st_ctime_ns,
+            ),
+            f"regular file changed while attesting: {path}",
+        )
+    finally:
+        os.close(descriptor)
+    actual_sha256 = digest.hexdigest()
+    _require(actual_sha256 == expected_sha256, f"regular file SHA-256 drifted: {path}")
+    if expected_bytes is not None:
+        _require(before.st_size == expected_bytes, f"regular file byte count drifted: {path}")
+    if expected_prefix is not None:
+        _require(prefix == expected_prefix, f"regular file prefix drifted: {path}")
+    return {"sha256": actual_sha256, "bytes": before.st_size}
+
