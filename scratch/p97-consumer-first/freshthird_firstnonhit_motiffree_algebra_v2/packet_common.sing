ring R=0,(x0,y0,x1,y1,x2,y2,x3,y3,x4,y4,x5,y5,x6,y6,x7,y7,x8,y8,x9,y9,x10,y10),dp;
ideal I =
  x3,
  y3,
  x2-1,
  y2,
  x3^2-2*x0*x3+y3^2-2*y0*y3-x2^2+2*x0*x2-y2^2+2*y0*y2,
  x4^2-2*x0*x4+y4^2-2*y0*y4-x2^2+2*x0*x2-y2^2+2*y0*y2,
  x5^2-2*x0*x5+y5^2-2*y0*y5-x2^2+2*x0*x2-y2^2+2*y0*y2,
  x3^2-2*x0*x3+y3^2-2*y0*y3-x2^2+2*x0*x2-y2^2+2*y0*y2,
  x4^2-2*x0*x4+y4^2-2*y0*y4-x2^2+2*x0*x2-y2^2+2*y0*y2,
  x5^2-2*x0*x5+y5^2-2*y0*y5-x2^2+2*x0*x2-y2^2+2*y0*y2,
  x5^2-2*x7*x5+y5^2-2*y7*y5-x3^2+2*x7*x3-y3^2+2*y7*y3,
  x4^2-2*x8*x4+y4^2-2*y8*y4-x2^2+2*x8*x2-y2^2+2*y8*y2,
  x9^2-2*x1*x9+y9^2-2*y1*y9-x4^2+2*x1*x4-y4^2+2*y1*y4,
  x10^2-2*x6*x10+y10^2-2*y6*y10-x2^2+2*x6*x2-y2^2+2*y6*y2;
ideal G=std(I);
if (size(G)==1 and G[1]==1) { print("ALGEBRA_VERDICT=UNIT"); } else { print("ALGEBRA_VERDICT=NONUNIT"); print("ALGEBRA_DIM="); print(dim(G)); }
quit;
