           (ite row0_p2 1 0)
           (ite row0_q2 1 0)
           (ite row0_f0 1 0)
           (ite row0_f1 1 0))
        4)
   4))
(assert (=> (= deletionArm0 1) (and (= row0_p1 false) (= row0_q2 false))))
(assert (= (ite (= deletionArm0 1)
