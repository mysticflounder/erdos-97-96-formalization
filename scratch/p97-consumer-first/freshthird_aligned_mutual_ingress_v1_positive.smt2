           (ite row1_source1 1 0)
           (ite row1_p2 1 0)
           (ite row1_q1 1 0)
           (ite row1_f0 1 0)
           (ite row1_f1 1 0))
        4)
   4))
(assert (=> (= deletionArm1 2) (and (= row1_p2 false) (= row1_q1 false))))
(assert (= (ite (= deletionArm1 2)
