           (ite row0_source1 1 0)
           (ite row0_p2 1 0)
           (ite row0_q1 1 0)
           (ite row0_f0 1 0)
           (ite row0_f1 1 0))
        4)
   4))
(assert (=> (= deletionArm0 2) (and (= row0_p2 false) (= row0_q1 false))))
(assert (= (ite (= deletionArm0 2)
