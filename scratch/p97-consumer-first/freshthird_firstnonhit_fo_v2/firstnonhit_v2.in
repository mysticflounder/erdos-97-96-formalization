% v2 source-mapped FirstNonHit incidence core.
% Derived from freshthird_firstnonhit_fo_v1/firstnonhit_base.in.
% The only added source-backed constraints are the two retained blocker
% equalities, hblockersNe, and fifteen distinct carrier witnesses for 15 ≤ |D.A|.

formulas(assumptions).

  % Every carrier point has a chosen critical exact-four row.
  all u (car(u) -> car(cen(u))).
  all u (car(u) -> cen(u) != u).
  all u all v (mem(u,v) -> car(u) & car(v)).
  all u (car(u) -> mem(u,u)).
  all u (
    car(u) ->
      exists v exists w exists x exists y (
        mem(u,v) & mem(u,w) & mem(u,x) & mem(u,y) &
        v != w & v != x & v != y &
        w != x & w != y & x != y &
        all z (mem(u,z) -> (z = v | z = w | z = x | z = y))
      )
  ).

  % Equal actual blocker centers give equal selected supports.
  all u all v all w (
    car(u) & car(v) & cen(u) = cen(v) ->
      (mem(u,w) <-> mem(v,w))
  ).

  % Three common support points force equal centers.
  all u all v all w all x all y (
    car(u) & car(v) & cen(u) != cen(v) &
    mem(u,w) & mem(v,w) &
    mem(u,x) & mem(v,x) &
    mem(u,y) & mem(v,y) ->
      (w = x | w = y | x = y)
  ).

  % A deletion blocked at a chosen critical center lies in that row.
  all u all v (
    car(u) & car(v) & blocked(v,cen(u)) -> mem(u,v)
  ).

  % CriticalShellSystem.no_qfree_at for the source's own deletion.
  all u (car(u) -> blocked(u,cen(u))).

  % Every actual-blocker fiber contains at most four carrier sources.
  all u all v all w all x all y (
    car(u) & car(v) & car(w) & car(x) & car(y) &
    cen(u) = cen(v) & cen(u) = cen(w) &
    cen(u) = cen(x) & cen(u) = cen(y) ->
      (u = v | u = w | u = x | u = y |
       v = w | v = x | v = y |
       w = x | w = y | x = y)
  ).

  % Named carrier points: two retained endpoint pairs, Q, C, and oppApex1.
  car(pa). car(pb). car(ra). car(rb).
  car(qa). car(qb). car(ca). car(cb). car(oa).

  % The retained endpoint pairs are disjoint, and Q/C avoid them.
  pa != pb. ra != rb.
  pa != ra. pa != rb. pb != ra. pb != rb.
  qa != qb. ca != cb.
  qa != pa. qa != pb. qa != ra. qa != rb.
  qb != pa. qb != pb. qb != ra. qb != rb.
  ca != pa. ca != pb. ca != ra. ca != rb.
  cb != pa. cb != pb. cb != ra. cb != rb.
  ca != oa. cb != oa.
  pa != oa. pb != oa. ra != oa. rb != oa.

  % Source-clean FreshThird Q facts and sameBlocker/sameBlocker branch.
  mem(qa,qb). mem(qb,qa).
  cen(qa) != cen(pa). cen(qa) != cen(ra).
  cen(qa) = cen(qb).
  cen(ca) = cen(qa).
  cen(cb) = cen(qa).
  cen(ca) != oa. cen(cb) != oa.

  % Each source row omits an endpoint from each retained pair and shares one.
  (-mem(ca,pa) | -mem(ca,pb)).
  (-mem(ca,ra) | -mem(ca,rb)).
  (-mem(cb,pa) | -mem(cb,pb)).
  (-mem(cb,ra) | -mem(cb,rb)).
  (co = pa | co = pb | co = ra | co = rb).
  -mem(ca,co). -mem(cb,co).

  % Omission/survival equivalence on the four retained endpoints.
  all v (
    (v = pa | v = pb | v = ra | v = rb) ->
      (-mem(ca,v) <-> -blocked(v,cen(ca)))
  ).
  all v (
    (v = pa | v = pb | v = ra | v = rb) ->
      (-mem(cb,v) <-> -blocked(v,cen(cb)))
  ).
  -blocked(pa,oa). -blocked(ra,oa).

  % Added source-backed RetainedInteriorBlockerCollision.blockers_eq,
  % instantiated for both radius rows P and Pρ.
  cen(pa) = cen(pb).
  cen(ra) = cen(rb).

  % Added source-backed target hblockersNe:
  % center(Pρ.source₁) != center(P.source₁).
  cen(ra) != cen(pa).

  % Added source-backed ATailExactFifteenApexProfile guard:
  % 15 <= D.A.card, represented by fifteen distinct carrier witnesses.
  car(g0). car(g1). car(g2). car(g3). car(g4).
  car(g5). car(g6). car(g7). car(g8). car(g9).
  car(g10). car(g11). car(g12). car(g13). car(g14).
  g0 != g1. g0 != g2. g0 != g3. g0 != g4. g0 != g5.
  g0 != g6. g0 != g7. g0 != g8. g0 != g9.
  g1 != g2. g1 != g3. g1 != g4. g1 != g5. g1 != g6.
  g1 != g7. g1 != g8. g1 != g9.
  g2 != g3. g2 != g4. g2 != g5. g2 != g6. g2 != g7.
  g2 != g8. g2 != g9.
  g3 != g4. g3 != g5. g3 != g6. g3 != g7. g3 != g8.
  g3 != g9.
  g4 != g5. g4 != g6. g4 != g7. g4 != g8. g4 != g9.
  g5 != g6. g5 != g7. g5 != g8. g5 != g9.
  g6 != g7. g6 != g8. g6 != g9.
  g7 != g8. g7 != g9.
  g8 != g9.
  g0 != g10. g0 != g11. g0 != g12. g0 != g13. g0 != g14.
  g1 != g10. g1 != g11. g1 != g12. g1 != g13. g1 != g14.
  g2 != g10. g2 != g11. g2 != g12. g2 != g13. g2 != g14.
  g3 != g10. g3 != g11. g3 != g12. g3 != g13. g3 != g14.
  g4 != g10. g4 != g11. g4 != g12. g4 != g13. g4 != g14.
  g5 != g10. g5 != g11. g5 != g12. g5 != g13. g5 != g14.
  g6 != g10. g6 != g11. g6 != g12. g6 != g13. g6 != g14.
  g7 != g10. g7 != g11. g7 != g12. g7 != g13. g7 != g14.
  g8 != g10. g8 != g11. g8 != g12. g8 != g13. g8 != g14.
  g9 != g10. g9 != g11. g9 != g12. g9 != g13. g9 != g14.
  g10 != g11. g10 != g12. g10 != g13. g10 != g14.
  g11 != g12. g11 != g13. g11 != g14.
  g12 != g13. g12 != g14.
  g13 != g14.

end_of_list.
