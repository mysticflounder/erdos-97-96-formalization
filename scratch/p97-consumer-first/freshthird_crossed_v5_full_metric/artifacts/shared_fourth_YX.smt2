(set-logic QF_NRA)
(declare-fun F_x () Real)
(declare-fun F_y () Real)
(declare-fun p2_y () Real)
(declare-fun p2_x () Real)
(declare-fun p1_y () Real)
(declare-fun p1_x () Real)
(declare-fun X_y () Real)
(declare-fun X_x () Real)
(declare-fun Y_y () Real)
(declare-fun Y_x () Real)
(declare-fun s2_y () Real)
(declare-fun C0_y () Real)
(declare-fun s2_x () Real)
(declare-fun C0_x () Real)
(declare-fun s1_y () Real)
(declare-fun s1_x () Real)
(declare-fun W_y () Real)
(declare-fun W_x () Real)
(declare-fun r2_y () Real)
(declare-fun O_y () Real)
(declare-fun r2_x () Real)
(declare-fun O_x () Real)
(declare-fun r1_y () Real)
(declare-fun r1_x () Real)
(declare-fun A_y () Real)
(declare-fun A_x () Real)
(assert (= F_x 0.0))
(assert (= F_y 0.0))
(assert (= (+ (^ (- F_x p1_x) 2.0) (^ (- F_y p1_y) 2.0))
   (+ (^ (- F_x p2_x) 2.0) (^ (- F_y p2_y) 2.0))))
(assert (= (+ (^ (- F_x p1_x) 2.0) (^ (- F_y p1_y) 2.0))
   (+ (^ (- F_x X_x) 2.0) (^ (- F_y X_y) 2.0))))
(assert (= (+ (^ (- F_x p1_x) 2.0) (^ (- F_y p1_y) 2.0))
   (+ (^ (- F_x Y_x) 2.0) (^ (- F_y Y_y) 2.0))))
(assert (= (+ (^ (- C0_x s1_x) 2.0) (^ (- C0_y s1_y) 2.0))
   (+ (^ (- C0_x s2_x) 2.0) (^ (- C0_y s2_y) 2.0))))
(assert (= (+ (^ (- C0_x s1_x) 2.0) (^ (- C0_y s1_y) 2.0))
   (+ (^ (- C0_x Y_x) 2.0) (^ (- C0_y Y_y) 2.0))))
(assert (= (+ (^ (- C0_x s1_x) 2.0) (^ (- C0_y s1_y) 2.0))
   (+ (^ (- C0_x W_x) 2.0) (^ (- C0_y W_y) 2.0))))
(assert (= (+ (^ (- O_x r1_x) 2.0) (^ (- O_y r1_y) 2.0))
   (+ (^ (- O_x r2_x) 2.0) (^ (- O_y r2_y) 2.0))))
(assert (= (+ (^ (- O_x r1_x) 2.0) (^ (- O_y r1_y) 2.0))
   (+ (^ (- O_x X_x) 2.0) (^ (- O_y X_y) 2.0))))
(assert (= (+ (^ (- O_x r1_x) 2.0) (^ (- O_y r1_y) 2.0))
   (+ (^ (- O_x W_x) 2.0) (^ (- O_y W_y) 2.0))))
(assert (= (+ (^ (- A_x p1_x) 2.0) (^ (- A_y p1_y) 2.0))
   (+ (^ (- A_x p2_x) 2.0) (^ (- A_y p2_y) 2.0))))
(assert (= (+ (^ (- A_x r1_x) 2.0) (^ (- A_y r1_y) 2.0))
   (+ (^ (- A_x r2_x) 2.0) (^ (- A_y r2_y) 2.0))))
(assert (distinct (+ (^ (- C0_x X_x) 2.0) (^ (- C0_y X_y) 2.0))
          (+ (^ (- C0_x Y_x) 2.0) (^ (- C0_y Y_y) 2.0))))
(assert (distinct (+ (^ (- O_x Y_x) 2.0) (^ (- O_y Y_y) 2.0))
          (+ (^ (- O_x X_x) 2.0) (^ (- O_y X_y) 2.0))))
(assert (distinct (+ (^ (- A_x p1_x) 2.0) (^ (- A_y p1_y) 2.0))
          (+ (^ (- A_x r1_x) 2.0) (^ (- A_y r1_y) 2.0))))
(assert (or (distinct p1_x p2_x) (distinct p1_y p2_y)))
(assert (or (distinct r1_x r2_x) (distinct r1_y r2_y)))
(assert (or (distinct s1_x s2_x) (distinct s1_y s2_y)))
(assert (or (distinct p1_x r1_x) (distinct p1_y r1_y)))
(assert (or (distinct p1_x r2_x) (distinct p1_y r2_y)))
(assert (or (distinct p2_x r1_x) (distinct p2_y r1_y)))
(assert (or (distinct p2_x r2_x) (distinct p2_y r2_y)))
(assert (or (distinct s1_x p1_x) (distinct s1_y p1_y)))
(assert (or (distinct s1_x p2_x) (distinct s1_y p2_y)))
(assert (or (distinct s1_x r1_x) (distinct s1_y r1_y)))
(assert (or (distinct s1_x r2_x) (distinct s1_y r2_y)))
(assert (or (distinct s2_x p1_x) (distinct s2_y p1_y)))
(assert (or (distinct s2_x p2_x) (distinct s2_y p2_y)))
(assert (or (distinct s2_x r1_x) (distinct s2_y r1_y)))
(assert (or (distinct s2_x r2_x) (distinct s2_y r2_y)))
(assert (or (distinct X_x Y_x) (distinct X_y Y_y)))
(assert (or (distinct X_x p1_x) (distinct X_y p1_y)))
(assert (or (distinct Y_x p1_x) (distinct Y_y p1_y)))
(assert (or (distinct X_x p2_x) (distinct X_y p2_y)))
(assert (or (distinct Y_x p2_x) (distinct Y_y p2_y)))
(assert (or (distinct X_x r1_x) (distinct X_y r1_y)))
(assert (or (distinct Y_x r1_x) (distinct Y_y r1_y)))
(assert (or (distinct X_x r2_x) (distinct X_y r2_y)))
(assert (or (distinct Y_x r2_x) (distinct Y_y r2_y)))
(assert (or (distinct X_x s1_x) (distinct X_y s1_y)))
(assert (or (distinct Y_x s1_x) (distinct Y_y s1_y)))
(assert (or (distinct X_x s2_x) (distinct X_y s2_y)))
(assert (or (distinct Y_x s2_x) (distinct Y_y s2_y)))
(assert (or (distinct X_x F_x) (distinct X_y F_y)))
(assert (or (distinct Y_x F_x) (distinct Y_y F_y)))
(assert (or (distinct X_x O_x) (distinct X_y O_y)))
(assert (or (distinct Y_x O_x) (distinct Y_y O_y)))
(assert (or (distinct W_x p1_x) (distinct W_y p1_y)))
(assert (or (distinct W_x p2_x) (distinct W_y p2_y)))
(assert (or (distinct W_x r1_x) (distinct W_y r1_y)))
(assert (or (distinct W_x r2_x) (distinct W_y r2_y)))
(assert (or (distinct W_x s1_x) (distinct W_y s1_y)))
(assert (or (distinct W_x s2_x) (distinct W_y s2_y)))
(assert (or (distinct W_x X_x) (distinct W_y X_y)))
(assert (or (distinct W_x Y_x) (distinct W_y Y_y)))
(assert (or (distinct W_x F_x) (distinct W_y F_y)))
(assert (or (distinct W_x C0_x) (distinct W_y C0_y)))
(assert (or (distinct W_x O_x) (distinct W_y O_y)))
(assert (or (distinct F_x p1_x) (distinct F_y p1_y)))
(assert (or (distinct F_x p2_x) (distinct F_y p2_y)))
(assert (or (distinct F_x X_x) (distinct F_y X_y)))
(assert (or (distinct F_x Y_x) (distinct F_y Y_y)))
(assert (or (distinct C0_x s1_x) (distinct C0_y s1_y)))
(assert (or (distinct C0_x s2_x) (distinct C0_y s2_y)))
(assert (or (distinct C0_x Y_x) (distinct C0_y Y_y)))
(assert (or (distinct C0_x W_x) (distinct C0_y W_y)))
(assert (or (distinct O_x r1_x) (distinct O_y r1_y)))
(assert (or (distinct O_x r2_x) (distinct O_y r2_y)))
(assert (or (distinct O_x X_x) (distinct O_y X_y)))
(assert (or (distinct O_x W_x) (distinct O_y W_y)))
(assert (or (distinct A_x p1_x) (distinct A_y p1_y)))
(assert (or (distinct A_x p2_x) (distinct A_y p2_y)))
(assert (or (distinct A_x r1_x) (distinct A_y r1_y)))
(assert (or (distinct A_x r2_x) (distinct A_y r2_y)))
(assert (or (distinct F_x O_x) (distinct F_y O_y)))
(assert (or (distinct C0_x F_x) (distinct C0_y F_y)))
(assert (or (distinct C0_x O_x) (distinct C0_y O_y)))

(check-sat)
(get-model)
