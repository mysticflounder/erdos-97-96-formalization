ring R=0,(x0,y0,x1,y1,x2,y2,x3,y3,x4,y4,x5,y5,x6,y6,x7,y7,x8,y8,x9,y9,x10,y10,x11,y11,x12,y12,x13,y13,x14,y14,x15,y15,x16,y16),dp;
ideal I =
  x0,
  y0,
  x1-1,
  y1,
  x3^2-2*x1*x3+y3^2-2*y1*y3-x0^2+2*x1*x0-y0^2+2*y1*y0,
  x6^2-2*x1*x6+y6^2-2*y1*y6-x0^2+2*x1*x0-y0^2+2*y1*y0,
  x9^2-2*x1*x9+y9^2-2*y1*y9-x0^2+2*x1*x0-y0^2+2*y1*y0,
  x0^2-2*x2*x0+y0^2-2*y2*y0-x3^2+2*x2*x3-y3^2+2*y2*y3,
  x8^2-2*x2*x8+y8^2-2*y2*y8-x3^2+2*x2*x3-y3^2+2*y2*y3,
  x11^2-2*x2*x11+y11^2-2*y2*y11-x3^2+2*x2*x3-y3^2+2*y2*y3,
  x1^2-2*x3*x1+y1^2-2*y3*y1-x6^2+2*x3*x6-y6^2+2*y3*y6,
  x5^2-2*x3*x5+y5^2-2*y3*y5-x6^2+2*x3*x6-y6^2+2*y3*y6,
  x9^2-2*x3*x9+y9^2-2*y3*y9-x6^2+2*x3*x6-y6^2+2*y3*y6,
  x3^2-2*x5*x3+y3^2-2*y5*y3-x10^2+2*x5*x10-y10^2+2*y5*y10,
  x11^2-2*x5*x11+y11^2-2*y5*y11-x10^2+2*x5*x10-y10^2+2*y5*y10,
  x9^2-2*x5*x9+y9^2-2*y5*y9-x10^2+2*x5*x10-y10^2+2*y5*y10,
  x1^2-2*x8*x1+y1^2-2*y8*y1-x13^2+2*x8*x13-y13^2+2*y8*y13,
  x3^2-2*x8*x3+y3^2-2*y8*y3-x13^2+2*x8*x13-y13^2+2*y8*y13,
  x10^2-2*x8*x10+y10^2-2*y8*y10-x13^2+2*x8*x13-y13^2+2*y8*y13,
  x2^2-2*x9*x2+y2^2-2*y9*y2-x14^2+2*x9*x14-y14^2+2*y9*y14,
  x3^2-2*x9*x3+y3^2-2*y9*y3-x14^2+2*x9*x14-y14^2+2*y9*y14,
  x8^2-2*x9*x8+y8^2-2*y9*y8-x14^2+2*x9*x14-y14^2+2*y9*y14;
ideal G = std(I);
if (size(G)==1 and G[1]==1) { print("ALGEBRA_VERDICT=UNIT"); } else { print("ALGEBRA_VERDICT=NONUNIT"); }
quit;
