% Control: explicit distinct-center three-overlap producer.
formulas(assumptions).
  car(ta) & car(da) & car(db) & car(dc).
  da != db & da != dc & db != dc.
  cen(ta) != cen(qa).
  mem(qa,da) & mem(qa,db) & mem(qa,dc).
  mem(ta,da) & mem(ta,db) & mem(ta,dc).
end_of_list.
formulas(goals).
  $false.
end_of_list.
