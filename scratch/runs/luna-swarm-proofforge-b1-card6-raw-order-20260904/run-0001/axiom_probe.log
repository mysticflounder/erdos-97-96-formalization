Problem97.ATailFrontierLiveClosure.B1CardSixRawOrderIngress.raw_btw_iff_ambient {D : CounterexampleData}
  {S : SurplusCapPacket D.A} {radius : ℝ} {H : CriticalShellSystem D.A}
  {F : ATailCriticalPairFrontier.CriticalPairFrontier D S radius H} {C : B1GlobalTransportContext}
  (P : B1CardSixLocalRolePacket C) (hsubset : roleCarrier P ⊆ D.A)
  (B : Census554.GeneralCarrierBridge.BoundaryIndexing D.A) (i j k : Fin (roleCarrier P).card) :
  SurplusCOMPGBank.btw ((orderedRoleEmbedding P hsubset B) i) ((orderedRoleEmbedding P hsubset B) j)
      ((orderedRoleEmbedding P hsubset B) k) ↔
    SurplusCOMPGBank.btw i j k
Problem97.ATailFrontierLiveClosure.B1CardSixRawOrderIngress.raw_btw_role_iff_ambient {D : CounterexampleData}
  {S : SurplusCapPacket D.A} {radius : ℝ} {H : CriticalShellSystem D.A}
  {F : ATailCriticalPairFrontier.CriticalPairFrontier D S radius H} {C : B1GlobalTransportContext}
  (P : B1CardSixLocalRolePacket C) (B : Census554.GeneralCarrierBridge.BoundaryIndexing D.A)
  (r s t : B1CardSixPointConfigurationIngress.B1CardSixRole) :
  SurplusCOMPGBank.btw (roleIndex P B r) (roleIndex P B s) (roleIndex P B t) ↔
    SurplusCOMPGBank.btw (B.indexOf (ambientRoleLabel P ⋯ r)) (B.indexOf (ambientRoleLabel P ⋯ s))
      (B.indexOf (ambientRoleLabel P ⋯ t))
