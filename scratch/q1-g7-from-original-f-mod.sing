option(redSB);
ring r=32003,(br,bs,bu,bv,bw,zr,zs,zu,zv,zw),dp;
poly f1=(br-bw)*zr+(-bs+bw)*zs+(-br+bs)*zw;
poly f2=(br-bw)*zr+(-bu+bw)*zu+(-br+bu)*zw;
poly f3=-bs*zs+1;
poly f4=-bw*zw+1;
poly f5=(-bs+bu)*zs+(bs-bu)*zu+1;
poly f6=(-bs+bv)*zs+(bs-bv)*zv+1;
poly f7=br*zr-bv*zv;
poly f8=(bv-1)*zv+(1-bw)*zw+(-bv+bw);
poly f9=(br-bv)*zr+(1-br)*zv+(bv-1);
poly f10=(1-bu)*zr+(-br+bu)*zu+(br-1);
poly f11=(1-bv)*zu+(-bu+bv)*zv+(bu-1);
poly q1=bs^3-2*bs^2*bu+bs*bu^2-bs^2*bw+bs*bu*bw-bu^2*bw+bs*bw^2; ideal F=f1,f2,f3,f4,f5,f6,f7,f8,f9,f10,f11,q1;
poly G3=br^2*bs*bv-br*bs*bv^2+bs*bv^3-br*bs*bv;
matrix C=lift(F,ideal(G3));
poly check=0;
int total=0;
int md=0;
for (int i=1;i<=12;i++)
{
  check=check+C[i,1]*F[i];
  total=total+size(C[i,1]);
  if (deg(C[i,1])>md) { md=deg(C[i,1]); }
  "C"+string(i)+" terms="+string(size(C[i,1]))+" degree="+string(deg(C[i,1]));
}
"IDENTITY="+string(reduce(G3-check,std(F))==0)+" terms="+string(total)+" maxdeg="+string(md);
write("g3-from-original-f.singexpr", "");
for (int i=1;i<=12;i++) { write("g3-from-original-f.singexpr", "C"+string(i)+"="+string(C[i,1])+";"); }
quit;
