ring B=0,(br,bs,bu,bv,bw),dp;
matrix M[11][6]=
br-bw,-bs+bw,0,0,-br+bs,0,
br-bw,0,-bu+bw,0,-br+bu,0,
0,-bs,0,0,0,1,
0,0,0,0,-bw,1,
0,-bs+bu,bs-bu,0,0,1,
0,-bs+bv,0,bs-bv,0,1,
br,0,0,-bv,0,0,
0,0,0,bv-1,1-bw,-bv+bw,
br-bv,0,0,1-br,0,bv-1,
1-bu,0,-br+bu,0,0,br-1,
0,0,1-bv,-bu+bv,0,bu-1;
ideal K=minor(M,6); ideal L; ideal BSI=std(bs); ideal BWI=std(bw); poly p; int k;
for(k=1;k<=size(K);k++)
{
 p=K[k]; while(p!=0 and reduce(p,BSI)==0){p=p/bs;} while(p!=0 and reduce(p,BWI)==0){p=p/bw;}
 if(p!=0 and size(p)<=16){L[size(L)+1]=p;}
}
poly e1=L[1]; poly e2=L[2]; poly e5=L[5]; poly e7=L[7]/br;
poly e8=L[8]/(br*(bv-1)); poly e9=L[9]/(bv-1); poly q1=e1/(bv*(br-bw));
ideal H=e2,e5,e7,e8,e9,q1;
matrix T; ideal U=liftstd(H,T);
poly target=bv^2*bw^3*(bv-1)^2;
matrix C=lift(U,ideal(target));
matrix D=T*C;
poly reconstructed; int total=0; int md=0; int i; int ctotal=0; int cmd=0; int csupport=0;
for(i=1;i<=nrows(C);i++)
{
 ctotal=ctotal+size(C[i,1]);
 if(C[i,1]!=0)
 {
  csupport++; if(deg(C[i,1])>cmd){cmd=deg(C[i,1]);}
  int tt=0; int tm=0; int j;
  for(j=1;j<=nrows(T);j++){tt=tt+size(T[j,i]); if(T[j,i]!=0 and deg(T[j,i])>tm){tm=deg(T[j,i]);}}
  write("scratch/q1_bv1_staged_support.out","U="+string(i)+" cterms="+string(size(C[i,1]))+" cdeg="+string(deg(C[i,1]))+" Uterms="+string(size(U[i]))+" Tterms="+string(tt)+" Tdeg="+string(tm));
 }
}
print("stage2_support="+string(csupport)+" terms="+string(ctotal)+" maxdeg="+string(cmd));
for(i=1;i<=nrows(D);i++)
{
 reconstructed=reconstructed+D[i,1]*H[i];
 total=total+size(D[i,1]);
 if(D[i,1]!=0 and deg(D[i,1])>md){md=deg(D[i,1]);}
 write("scratch/q1_bv1_staged_exact.singexpr",string(D[i,1]));
}
print("identity="+string(reconstructed==target)+" terms="+string(total)+" maxdeg="+string(md));
quit;
