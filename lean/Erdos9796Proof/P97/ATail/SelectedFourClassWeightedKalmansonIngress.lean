import Erdos9796Proof.P97.ATail.FrontierLiveClosure.GenericRowNogoodCertificate

/-!
# Selected-four ingress for checked weighted Kalmanson cancellation

This module turns a boundary-indexed family of geometric `SelectedFourClass`
rows into the finite row pattern consumed by the cardinality-generic checked
cancellation certificate.  Checked equality paths may use row steps and edge
reversal, so they certify equal distances on unordered boundary edges.

The weighted certificate records a positive natural combination of strict
Kalmanson forms.  Its checked pairing permutes the repeated left and right
edge multisets and supplies one equality path for every paired occurrence.
-/

namespace Problem97
namespace SelectedFourClassWeightedKalmansonIngress

open Census554.EqualityCore
open ATailFrontierLiveClosure.GenericRowNogoodCertificate
open scoped EuclideanGeometry

/-- The finite row pattern induced by all memberships in a boundary-indexed
family of selected four-classes. -/
noncomputable def selectedFourRowPattern
    {A : Finset ℝ²} {n : ℕ} (boundary : Fin n → ℝ²)
    (rows : ∀ center, SelectedFourClass A (boundary center)) :
    RowPattern (Fin n) :=
  fun center => Finset.univ.filter fun point =>
    boundary point ∈ (rows center).support

@[simp] theorem mem_selectedFourRowPattern
    {A : Finset ℝ²} {n : ℕ} (boundary : Fin n → ℝ²)
    (rows : ∀ center, SelectedFourClass A (boundary center))
    (center point : Fin n) :
    point ∈ selectedFourRowPattern boundary rows center ↔
      boundary point ∈ (rows center).support := by
  classical
  simp [selectedFourRowPattern]

/-- Injective boundary coordinates realize the finite pattern induced by a
family of selected four-classes. -/
theorem realizes_selectedFourRowPattern
    {A : Finset ℝ²} {n : ℕ} (boundary : Fin n → ℝ²)
    (hinjective : Function.Injective boundary)
    (rows : ∀ center, SelectedFourClass A (boundary center)) :
    Realizes (selectedFourRowPattern boundary rows) boundary := by
  refine ⟨?_, hinjective⟩
  intro center first hfirst second hsecond
  rw [mem_selectedFourRowPattern] at hfirst hsecond
  exact ((rows center).support_eq_radius _ hfirst).trans
    ((rows center).support_eq_radius _ hsecond).symm

/-- Every finite row choice used by a certificate names only memberships in
the corresponding geometric selected four-class. -/
def SelectedFourRowsCover
    {A : Finset ℝ²} {n : ℕ} (boundary : Fin n → ℝ²)
    (rows : ∀ center, SelectedFourClass A (boundary center))
    (choices : List (RowChoice (Fin n))) : Prop :=
  ∀ choice ∈ choices, ∀ point ∈ choice.support,
    boundary point ∈ (rows choice.center).support

/-- Geometric coverage of the recorded finite choices supplies the positive
row semantics required by the checked equality-path kernel. -/
theorem positiveRowsMatch_selectedFourRowPattern
    {A : Finset ℝ²} {n : ℕ} (boundary : Fin n → ℝ²)
    (rows : ∀ center, SelectedFourClass A (boundary center))
    (choices : List (RowChoice (Fin n)))
    (hcover : SelectedFourRowsCover boundary rows choices) :
    PositiveRowsMatch (selectedFourRowPattern boundary rows) choices := by
  intro choice hchoice point hpoint
  rw [mem_selectedFourRowPattern]
  exact hcover choice hchoice point hpoint

/-- A checked path in the induced row pattern proves equality of the lengths
of its endpoint edges.  Edge reversal inside the path makes the result
insensitive to edge orientation. -/
theorem edgeDist_eq_of_selectedFourRowPattern_checkPath
    {A : Finset ℝ²} {n : ℕ} (boundary : Fin n → ℝ²)
    (hinjective : Function.Injective boundary)
    (rows : ∀ center, SelectedFourClass A (boundary center))
    (choices : List (RowChoice (Fin n)))
    (hcover : SelectedFourRowsCover boundary rows choices)
    (path : ClosurePathData (Fin n)) {first last : Edge (Fin n)}
    (hcheck : checkPath choices path first last = true) :
    edgeDist boundary first = edgeDist boundary last := by
  exact EdgeClosure.sound
    (realizes_selectedFourRowPattern boundary hinjective rows)
    (edgeClosure_of_checkPath_positive
      (positiveRowsMatch_selectedFourRowPattern boundary rows choices hcover)
      path hcheck)

/-- A checked positive natural combination of strict Kalmanson forms cannot
cancel through equality paths generated by a boundary-indexed family of
selected four-classes.  The statement is cardinality-generic and requires an
injective cyclic boundary realization. -/
theorem false_of_selectedFourClass_weightedKalmansonCancellationData_of_check
    {A : Finset ℝ²} (hA : ConvexIndep A)
    {n : ℕ} (boundary : Fin n → ℝ²)
    (hinjective : Function.Injective boundary)
    (himage : Finset.univ.image boundary = A)
    (hccw : EuclideanGeometry.IsCcwConvexPolygon boundary)
    (rows : ∀ center, SelectedFourClass A (boundary center))
    (choices : List (RowChoice (Fin n)))
    (hcover : SelectedFourRowsCover boundary rows choices)
    (data : WeightedKalmansonCancellationData (Fin n))
    (hcheck : data.check choices = true) : False := by
  let P := selectedFourRowPattern boundary rows
  have hreal : Realizes P boundary :=
    realizes_selectedFourRowPattern boundary hinjective rows
  have hpositive : PositiveRowsMatch P choices :=
    positiveRowsMatch_selectedFourRowPattern boundary rows choices hcover
  exact false_of_weightedKalmansonCancellationData_of_check
    hA himage hccw hreal choices hpositive data hcheck

end SelectedFourClassWeightedKalmansonIngress
end Problem97
