import Erdos9796Proof.P97.ATail.FrontierLiveClosure.Balanced555FiniteFormula
import Erdos9796Proof.P97.ATail.FrontierLiveClosure.Balanced555FiniteStructuralSatisfaction
import Erdos9796Proof.P97.ATail.FrontierLiveClosure.Generated.Balanced555DirectReplay.CompactWindowedRupReplay.Compose
import Erdos9796Proof.P97.Certificate.CheckpointedRupSemanticBoundary

/-!
# Certificate closure for the balanced 5-5-5 finite configuration

This module is the narrow semantic ingress for the authenticated direct-orientation
compact pure-RUP replay.  It identifies the replay's checkpoint-zero formula with
the executable balanced-555 clause list and transports the checker verdict to the
DIMACS semantics used by `Balanced555FiniteFormula`.
-/

open Std.Sat
open Std.Tactic.BVDecide.LRAT.Internal

namespace Problem97
namespace ATailFrontierLiveClosure
namespace Balanced555FiniteUnsat

open Balanced555FiniteFormula
open Census554.CoverCnf
open CheckpointedRup.CompactBoundary
open CheckpointedRup.SemanticBoundary
open ExactTwelveRigid221Ingress.TerminalBankConsumer

/-- An unsatisfiable compact-checker formula with exactly the requested signed
clauses rules out a Boolean DIMACS valuation of those clauses. -/
theorem dimacsUnsatisfiable_of_formula_eq
    {cnf : List (List Int)} {n : Nat} {formula : DefaultFormula n}
    (hunsat : Unsatisfiable (PosFin n) formula)
    (heq : signedClausesOfFormula formula = cnf) :
    DimacsUnsatisfiable cnf := by
  rintro ⟨valuation, hvaluation⟩
  apply hunsat (checkerAssignment (fun atom ↦ valuation atom = true))
  apply entails_formula_of_evalClauseD_sat valuation formula
  intro clause hclause
  apply hvaluation (signedClauseOfDefault clause)
  rw [← heq]
  exact List.mem_map.mpr ⟨clause, hclause, rfl⟩

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
-- This compares two closed 50,113-clause lists at the audited native boundary.
set_option linter.style.nativeDecide false in
/-- The authenticated direct replay starts from precisely the 50,113 clauses
generated by `Balanced555FiniteFormula.clauses .direct`. -/
theorem direct_checkpoint0_signedClauses_eq :
    signedClausesOfFormula
      (formulaOfCompact (n := Balanced555DirectReplay.n)
        Balanced555DirectReplay.Checkpoint.C0000.text) =
      clauses .direct := by
  native_decide

/-- The direct-orientation balanced-555 formula is unsatisfiable, by the
authenticated compact pure-RUP replay. -/
theorem directUnsatisfiable : DimacsUnsatisfiable (clauses .direct) :=
  dimacsUnsatisfiable_of_formula_eq
    Balanced555DirectReplay.startUnsatisfiable
    direct_checkpoint0_signedClauses_eq

/-- Reflection transports the direct certificate to the mirror-oriented
balanced-555 formula. -/
theorem mirrorUnsatisfiable : DimacsUnsatisfiable (clauses .mirror) :=
  mirror_unsatisfiable_of_direct_checked directUnsatisfiable

/-- Every clause of the exact formula is true under the valuation induced by a
balanced finite configuration. -/
theorem configurationValuation_satisfies_clauses
    (configuration : Balanced555FiniteConfiguration) :
    ∀ clause ∈ clauses configuration.orientation,
      evalClauseD (configurationValuation configuration) clause = true := by
  rw [clauses_eq_structural_append_kalmansonSignedClauses]
  intro clause hclause
  rcases List.mem_append.mp hclause with hstructural | hkalmanson
  · obtain ⟨metadata, hmetadata, rfl⟩ := List.mem_map.mp hstructural
    exact configurationValuation_satisfies_structuralClause
      configuration metadata hmetadata
  · exact configurationValuation_satisfies_kalmansonSignedClause
      configuration clause hkalmanson

/-- Both boundary orientations are ruled out by the single authenticated direct
certificate and its checked reflection transport. -/
theorem orientationUnsatisfiable (orientation : Balanced555Orientation) :
    DimacsUnsatisfiable (clauses orientation) := by
  cases orientation with
  | direct => exact directUnsatisfiable
  | mirror => exact mirrorUnsatisfiable

/-- No source-entitled balanced `(5,5,5)` finite configuration exists. -/
theorem false_of_balanced555FiniteConfiguration
    (configuration : Balanced555FiniteConfiguration) : False :=
  orientationUnsatisfiable configuration.orientation
    ⟨configurationValuation configuration,
      configurationValuation_satisfies_clauses configuration⟩

end Balanced555FiniteUnsat
end ATailFrontierLiveClosure
end Problem97
