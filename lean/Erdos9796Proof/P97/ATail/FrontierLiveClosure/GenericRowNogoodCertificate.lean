import Erdos9796Proof.P97.Census554.EqualityCore
import Erdos9796Proof.P97.ATail.CapCrossingKalmanson

/-!
# Cardinality-generic checked row-nogood certificates

This module is the small trusted checker shared by finite carrier searches of
different cardinalities.  A certificate records concrete rows and a path in
the equality closure generated by those rows.  Its soundness is polymorphic in
the label type; in particular, it can be instantiated at `Fin 12` without
duplicating the fixed-`Fin 11` cap-selected checker.

The first supported terminal is `DuplicateCenterCore`, the dominant terminal
in the exact-twelve pentagon-off-class census.  This file proves certificate
soundness only; it does not assert finite coverage.
-/

namespace Problem97
namespace ATailFrontierLiveClosure
namespace GenericRowNogoodCertificate

open Census554.EqualityCore
open scoped EuclideanGeometry

/-- An injective partial assignment of finite labels extends to a
permutation.  Keeping this small combinatorial lemma here lets exact-cardinality
adapters pin their named source roles without importing a fixed-cardinality
census implementation. -/
theorem exists_permutation_extension {n : ℕ} {S : Finset (Fin n)}
    {f : Fin n → Fin n} (hf : Set.InjOn f S) :
    ∃ σ : Equiv.Perm (Fin n), ∀ i ∈ S, σ i = f i := by
  classical
  have hcard : Sᶜ.card = (S.image f)ᶜ.card := by
    rw [Finset.card_compl, Finset.card_compl,
      Finset.card_image_of_injOn hf]
  let complementEquiv := Finset.equivOfCardEq hcard
  let σ : Fin n → Fin n := fun i =>
    if hi : i ∈ S then f i
    else (complementEquiv ⟨i, Finset.mem_compl.mpr hi⟩ : Fin n)
  have hσ : Function.Injective σ := by
    intro i j hij
    by_cases hi : i ∈ S <;> by_cases hj : j ∈ S <;>
      simp only [σ, hi, hj, dif_pos, dif_neg, not_false_iff] at hij
    · exact hf hi hj hij
    · exact absurd (hij ▸ Finset.mem_image_of_mem f hi)
        (Finset.mem_compl.mp
          (complementEquiv ⟨j, Finset.mem_compl.mpr hj⟩).2)
    · exact absurd (hij ▸ Finset.mem_image_of_mem f hj)
        (Finset.mem_compl.mp
          (complementEquiv ⟨i, Finset.mem_compl.mpr hi⟩).2)
    · have heq := complementEquiv.injective (Subtype.coe_injective hij)
      exact congrArg Subtype.val heq
  let permutation : Equiv.Perm (Fin n) :=
    Function.Embedding.equivOfFiniteSelfEmbedding ⟨σ, hσ⟩
  refine ⟨permutation, ?_⟩
  intro i hi
  change σ i = f i
  simp [σ, hi]

/-- Label a finite carrier while prescribing finitely many inverse images.
The `pins` map says which carrier point each distinguished finite label must
denote. -/
theorem exists_equiv_with_pinned_inverse
    {α : Type*} [Fintype α] {n : ℕ}
    (hcard : Fintype.card α = n) {S : Finset (Fin n)}
    {pins : Fin n → α} (hpins : Set.InjOn pins S) :
    ∃ e : α ≃ Fin n, ∀ i ∈ S, e.symm i = pins i := by
  classical
  let base : α ≃ Fin n :=
    Fintype.equivOfCardEq (by simpa using hcard)
  let encoded : Fin n → Fin n := fun i => base (pins i)
  have hencoded : Set.InjOn encoded S := by
    intro i hi j hj hij
    exact hpins hi hj (base.injective hij)
  obtain ⟨σ, hσ⟩ := exists_permutation_extension hencoded
  refine ⟨base.trans σ.symm, ?_⟩
  intro i hi
  simp [encoded, hσ i hi]

/-- Relabel a row pattern along an equivalence. -/
def reindexRowPattern {α β : Type*} [DecidableEq β]
    (e : α ≃ β) (P : RowPattern α) : RowPattern β :=
  fun center => (P (e.symm center)).map e.toEmbedding

@[simp] theorem mem_reindexRowPattern_iff
    {α β : Type*} [DecidableEq β] (e : α ≃ β) (P : RowPattern α)
    (center point : β) :
    point ∈ reindexRowPattern e P center ↔
      e.symm point ∈ P (e.symm center) := by
  simp [reindexRowPattern]

/-- A geometric realization remains a realization after relabeling the
carrier.  The new interpretation sends a finite label back through the
labeling equivalence before reading its geometric point. -/
theorem realizes_reindexRowPattern
    {α β : Type*} [DecidableEq β] (e : α ≃ β)
    {P : RowPattern α} {pointOf : α → ℝ²}
    (hrealizes : Realizes P pointOf) :
    Realizes (reindexRowPattern e P) (fun i => pointOf (e.symm i)) := by
  refine ⟨?_, hrealizes.injective.comp e.symm.injective⟩
  intro center first hfirst second hsecond
  exact hrealizes.equidist (e.symm center) (e.symm first)
    ((mem_reindexRowPattern_iff e P center first).mp hfirst)
    (e.symm second)
    ((mem_reindexRowPattern_iff e P center second).mp hsecond)

/-- Relabel both endpoints of an oriented edge. -/
def reindexEdge {α β : Type*} (e : α ≃ β) : Edge α → Edge β
  | (first, second) => (e first, e second)

@[simp] theorem reindexEdge_symm_apply
    {α β : Type*} (e : α ≃ β) (edge : Edge β) :
    reindexEdge e.symm edge = (e.symm edge.1, e.symm edge.2) := by
  rfl

/-- Equality closure is preserved when a finite witness is transported back
through the equivalence used to label the carrier. -/
theorem edgeClosure_of_reindexRowPattern
    {α β : Type*} [DecidableEq β] (e : α ≃ β) {P : RowPattern α}
    {first last : Edge β}
    (hclosure : EdgeClosure (reindexRowPattern e P) first last) :
    EdgeClosure P (reindexEdge e.symm first) (reindexEdge e.symm last) := by
  induction hclosure with
  | row center a b ha hb =>
      exact EdgeClosure.row (e.symm center) (e.symm a) (e.symm b)
        ((mem_reindexRowPattern_iff e P center a).mp ha)
        ((mem_reindexRowPattern_iff e P center b).mp hb)
  | flip a b =>
      exact EdgeClosure.flip (e.symm a) (e.symm b)
  | refl edge =>
      exact EdgeClosure.refl (reindexEdge e.symm edge)
  | symm _ ih =>
      exact ih.symm
  | trans _ _ ih₁ ih₂ =>
      exact ih₁.trans ih₂

/-- One concrete center/support row used by a finite nogood. -/
structure RowChoice (α : Type*) where
  center : α
  support : Finset α
deriving DecidableEq

/-- Relabel one concrete row choice along an equivalence. -/
def reindexRowChoice {α β : Type*} [DecidableEq β]
    (e : α ≃ β) (choice : RowChoice α) : RowChoice β :=
  { center := e choice.center
    support := choice.support.map e.toEmbedding }

/-- Relabel a finite list of concrete row choices. -/
def reindexRowChoices {α β : Type*} [DecidableEq β]
    (e : α ≃ β) (choices : List (RowChoice α)) : List (RowChoice β) :=
  choices.map (reindexRowChoice e)

/-- A proof-facing pattern realizes every row named by the certificate. -/
def RowsMatch {α : Type*} (P : RowPattern α)
    (choices : List (RowChoice α)) : Prop :=
  ∀ choice, choice ∈ choices → P choice.center = choice.support

/-- The weaker row semantics emitted by the SAT journal: every listed support
point belongs to the source row, without yet claiming that the listed support
is the whole row. -/
def PositiveRowsMatch {α : Type*} (P : RowPattern α)
    (choices : List (RowChoice α)) : Prop :=
  ∀ choice, choice ∈ choices → choice.support ⊆ P choice.center

/-- Every recorded row has the four positive incidences expected by an
exact-four source row. -/
def FourSupportedRows {α : Type*} (choices : List (RowChoice α)) : Prop :=
  ∀ choice, choice ∈ choices → choice.support.card = 4

/-- Positive incidence data is exact when both the recorded and source rows
have cardinality four. -/
theorem rowsMatch_of_positiveRowsMatch_of_card_eq_four
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)}
    (hpositive : PositiveRowsMatch P choices)
    (hsource : ∀ center, (P center).card = 4)
    (hfour : FourSupportedRows choices) :
    RowsMatch P choices := by
  intro choice hchoice
  apply Eq.symm
  apply Finset.eq_of_subset_of_card_le (hpositive choice hchoice)
  rw [hsource, hfour choice hchoice]

/-- Exact source rows remain exact after relabeling the carrier. -/
theorem rowsMatch_reindexRowChoices
    {α β : Type*} [DecidableEq β] (e : α ≃ β)
    {P : RowPattern α} {choices : List (RowChoice α)}
    (hrows : RowsMatch P choices) :
    RowsMatch (reindexRowPattern e P) (reindexRowChoices e choices) := by
  intro choice hchoice
  simp only [reindexRowChoices, List.mem_map] at hchoice
  rcases hchoice with ⟨source, hsource, rfl⟩
  simp [reindexRowChoice, reindexRowPattern, hrows source hsource]

/-- The canonical list containing the exact row at every label.  This is the
proof-facing assignment extracted from a finite relabeling of a faithful
carrier pattern. -/
noncomputable def allRowChoices {α : Type*} [Fintype α] [DecidableEq α]
    (P : RowPattern α) : List (RowChoice α) :=
  Finset.univ.toList.map fun center =>
    { center := center, support := P center }

theorem rowsMatch_allRowChoices
    {α : Type*} [Fintype α] [DecidableEq α] (P : RowPattern α) :
    RowsMatch P (allRowChoices P) := by
  intro choice hchoice
  simp only [allRowChoices, List.mem_map] at hchoice
  rcases hchoice with ⟨center, _hcenter, rfl⟩
  rfl

/-- A primitive proof-free generator of equality closure. -/
inductive PrimitiveEqualityStep (α : Type*) where
  | row (center first second : α)
  | flip (first second : α)
deriving DecidableEq, Repr

def PrimitiveEqualityStep.source {α : Type*} :
    PrimitiveEqualityStep α → Edge α
  | .row center first _ => (center, first)
  | .flip first second => (first, second)

def PrimitiveEqualityStep.target {α : Type*} :
    PrimitiveEqualityStep α → Edge α
  | .row center _ second => (center, second)
  | .flip first second => (second, first)

/-- One executable equality-closure path. -/
structure ClosurePathData (α : Type*) where
  first : Edge α
  steps : List (PrimitiveEqualityStep α)
  last : Edge α
deriving DecidableEq, Repr

/-- Check that a primitive step is supported by one of the concrete rows. -/
def checkPrimitiveStep {α : Type*} [DecidableEq α]
    (choices : List (RowChoice α)) : PrimitiveEqualityStep α → Bool
  | .row center first second =>
      choices.any fun choice =>
        decide (choice.center = center ∧
          first ∈ choice.support ∧ second ∈ choice.support)
  | .flip _ _ => true

/-- Check composability and row support for every step of a path. -/
def checkStepChain {α : Type*} [DecidableEq α]
    (choices : List (RowChoice α)) :
    Edge α → List (PrimitiveEqualityStep α) → Edge α → Bool
  | first, [], last => decide (first = last)
  | first, step :: steps, last =>
      decide (first = step.source) && checkPrimitiveStep choices step &&
        checkStepChain choices step.target steps last

/-- Check a path's stated endpoints and all of its primitive steps. -/
def checkPath {α : Type*} [DecidableEq α]
    (choices : List (RowChoice α)) (path : ClosurePathData α)
    (first last : Edge α) : Bool :=
  (decide (path.first = first) && decide (path.last = last)) &&
    checkStepChain choices path.first path.steps path.last

theorem edgeClosure_of_checkPrimitiveStep
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : RowsMatch P choices)
    (step : PrimitiveEqualityStep α)
    (hcheck : checkPrimitiveStep choices step = true) :
    EdgeClosure P step.source step.target := by
  cases step with
  | row center first second =>
      rw [checkPrimitiveStep, List.any_eq_true] at hcheck
      rcases hcheck with ⟨choice, hchoice, hcheck⟩
      have hdata :
          choice.center = center ∧
            first ∈ choice.support ∧ second ∈ choice.support :=
        of_decide_eq_true hcheck
      rw [← hdata.1]
      have hrow := hrows choice hchoice
      exact EdgeClosure.row choice.center first second
        (by simpa [hrow] using hdata.2.1)
        (by simpa [hrow] using hdata.2.2)
  | flip first second =>
      exact EdgeClosure.flip first second

/-- The primitive checker only consumes positive row incidences.  Exact row
equality is therefore unnecessary when a certificate records a proper subset
of a source row. -/
theorem edgeClosure_of_checkPrimitiveStep_positive
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : PositiveRowsMatch P choices)
    (step : PrimitiveEqualityStep α)
    (hcheck : checkPrimitiveStep choices step = true) :
    EdgeClosure P step.source step.target := by
  cases step with
  | row center first second =>
      rw [checkPrimitiveStep, List.any_eq_true] at hcheck
      rcases hcheck with ⟨choice, hchoice, hcheck⟩
      have hdata :
          choice.center = center ∧
            first ∈ choice.support ∧ second ∈ choice.support :=
        of_decide_eq_true hcheck
      rw [← hdata.1]
      have hrow := hrows choice hchoice
      exact EdgeClosure.row choice.center first second
        (hrow hdata.2.1) (hrow hdata.2.2)
  | flip first second =>
      exact EdgeClosure.flip first second

theorem edgeClosure_of_checkStepChain
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : RowsMatch P choices)
    {first last : Edge α} {steps : List (PrimitiveEqualityStep α)}
    (hcheck : checkStepChain choices first steps last = true) :
    EdgeClosure P first last := by
  induction steps generalizing first with
  | nil =>
      simp only [checkStepChain, decide_eq_true_eq] at hcheck
      subst last
      exact EdgeClosure.refl first
  | cons step steps ih =>
      simp only [checkStepChain, Bool.and_eq_true,
        decide_eq_true_eq] at hcheck
      rcases hcheck with ⟨⟨hfirst, hstep⟩, htail⟩
      subst first
      exact EdgeClosure.trans
        (edgeClosure_of_checkPrimitiveStep hrows step hstep)
        (ih htail)

theorem edgeClosure_of_checkStepChain_positive
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : PositiveRowsMatch P choices)
    {first last : Edge α} {steps : List (PrimitiveEqualityStep α)}
    (hcheck : checkStepChain choices first steps last = true) :
    EdgeClosure P first last := by
  induction steps generalizing first with
  | nil =>
      simp only [checkStepChain, decide_eq_true_eq] at hcheck
      subst last
      exact EdgeClosure.refl first
  | cons step steps ih =>
      simp only [checkStepChain, Bool.and_eq_true,
        decide_eq_true_eq] at hcheck
      rcases hcheck with ⟨⟨hfirst, hstep⟩, htail⟩
      subst first
      exact EdgeClosure.trans
        (edgeClosure_of_checkPrimitiveStep_positive hrows step hstep)
        (ih htail)

theorem edgeClosure_of_checkPath
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : RowsMatch P choices)
    (path : ClosurePathData α) {first last : Edge α}
    (hcheck : checkPath choices path first last = true) :
    EdgeClosure P first last := by
  simp only [checkPath, Bool.and_eq_true, decide_eq_true_eq] at hcheck
  rcases hcheck with ⟨⟨hfirst, hlast⟩, hsteps⟩
  subst first
  subst last
  exact edgeClosure_of_checkStepChain hrows hsteps

theorem edgeClosure_of_checkPath_positive
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : PositiveRowsMatch P choices)
    (path : ClosurePathData α) {first last : Edge α}
    (hcheck : checkPath choices path first last = true) :
    EdgeClosure P first last := by
  simp only [checkPath, Bool.and_eq_true, decide_eq_true_eq] at hcheck
  rcases hcheck with ⟨⟨hfirst, hlast⟩, hsteps⟩
  subst first
  subst last
  exact edgeClosure_of_checkStepChain_positive hrows hsteps

/-- Which strict Kalmanson left-hand pair is used for an ordered convex
quadrilateral.  Both forms have the two diagonals as their right-hand pair. -/
inductive KalmansonForm where
  | adjacentSides
  | innerOuter
deriving DecidableEq, Repr

/-- Four labels asserted by a checked certificate to occur in increasing
boundary order. -/
structure OrderedQuadData (α : Type*) where
  a : α
  b : α
  c : α
  d : α
deriving DecidableEq, Repr

def OrderedQuadData.leftEdge0 {α : Type*}
    (q : OrderedQuadData α) : KalmansonForm → Edge α
  | .adjacentSides => (q.a, q.b)
  | .innerOuter => (q.b, q.c)

def OrderedQuadData.leftEdge1 {α : Type*}
    (q : OrderedQuadData α) : KalmansonForm → Edge α
  | .adjacentSides => (q.c, q.d)
  | .innerOuter => (q.a, q.d)

def OrderedQuadData.rightEdge0 {α : Type*}
    (q : OrderedQuadData α) : Edge α := (q.a, q.c)

def OrderedQuadData.rightEdge1 {α : Type*}
    (q : OrderedQuadData α) : Edge α := (q.b, q.d)

/-- Proof-free encoding of a permutation of four distance slots. -/
structure Permutation4Data where
  image0 : Fin 4
  image1 : Fin 4
  image2 : Fin 4
  image3 : Fin 4
deriving DecidableEq, Repr

def Permutation4Data.apply (p : Permutation4Data) : Fin 4 → Fin 4 :=
  ![p.image0, p.image1, p.image2, p.image3]

/-- Four distinct images in a four-element type are a permutation. -/
def Permutation4Data.check (p : Permutation4Data) : Bool :=
  decide (p.image0 ≠ p.image1 ∧ p.image0 ≠ p.image2 ∧
    p.image0 ≠ p.image3 ∧ p.image1 ≠ p.image2 ∧
    p.image1 ≠ p.image3 ∧ p.image2 ≠ p.image3)

theorem Permutation4Data.sum_comp_eq_of_check
    (p : Permutation4Data) (f : Fin 4 → ℝ)
    (hcheck : p.check = true) :
    ∑ i, f (p.apply i) = ∑ i, f i := by
  rcases p with ⟨i0, i1, i2, i3⟩
  fin_cases i0 <;> fin_cases i1 <;>
    fin_cases i2 <;> fin_cases i3 <;>
    simp [Permutation4Data.check, Permutation4Data.apply, Fin.sum_univ_four]
      at hcheck ⊢ <;> ring

/-- A checked two-Kalmanson cancellation certificate.  Four equality-closure
paths identify, up to a checked permutation, the four left-hand distances of
two strict Kalmanson inequalities with their four right-hand distances. -/
structure TwoKalmansonCancellationData (α : Type*) where
  firstQuad : OrderedQuadData α
  firstForm : KalmansonForm
  secondQuad : OrderedQuadData α
  secondForm : KalmansonForm
  permutation : Permutation4Data
  path0 : ClosurePathData α
  path1 : ClosurePathData α
  path2 : ClosurePathData α
  path3 : ClosurePathData α
deriving DecidableEq, Repr

def TwoKalmansonCancellationData.leftEdge {α : Type*}
    (data : TwoKalmansonCancellationData α) : Fin 4 → Edge α :=
  ![data.firstQuad.leftEdge0 data.firstForm,
    data.firstQuad.leftEdge1 data.firstForm,
    data.secondQuad.leftEdge0 data.secondForm,
    data.secondQuad.leftEdge1 data.secondForm]

def TwoKalmansonCancellationData.rightEdge {α : Type*}
    (data : TwoKalmansonCancellationData α) : Fin 4 → Edge α :=
  ![data.firstQuad.rightEdge0, data.firstQuad.rightEdge1,
    data.secondQuad.rightEdge0, data.secondQuad.rightEdge1]

/-- Executable validity check for a two-Kalmanson cancellation certificate. -/
def TwoKalmansonCancellationData.check {n : ℕ}
    (choices : List (RowChoice (Fin n)))
    (data : TwoKalmansonCancellationData (Fin n)) : Bool :=
  decide (data.firstQuad.a < data.firstQuad.b ∧
    data.firstQuad.b < data.firstQuad.c ∧
    data.firstQuad.c < data.firstQuad.d ∧
    data.secondQuad.a < data.secondQuad.b ∧
    data.secondQuad.b < data.secondQuad.c ∧
    data.secondQuad.c < data.secondQuad.d) &&
  data.permutation.check &&
  checkPath choices data.path0 (data.leftEdge 0)
    (data.rightEdge (data.permutation.apply 0)) &&
  checkPath choices data.path1 (data.leftEdge 1)
    (data.rightEdge (data.permutation.apply 1)) &&
  checkPath choices data.path2 (data.leftEdge 2)
    (data.rightEdge (data.permutation.apply 2)) &&
  checkPath choices data.path3 (data.leftEdge 3)
    (data.rightEdge (data.permutation.apply 3))

/-- Either checked form is one of the two strict Kalmanson inequalities for
the ordered quadrilateral. -/
theorem OrderedQuadData.kalmanson_lt
    {A : Finset ℝ²} (hA : ConvexIndep A)
    {n : ℕ} {boundary : Fin n → ℝ²}
    (hinj : Function.Injective boundary)
    (himage : Finset.univ.image boundary = A)
    (hccw : EuclideanGeometry.IsCcwConvexPolygon boundary)
    (q : OrderedQuadData (Fin n)) (form : KalmansonForm)
    (hab : q.a < q.b) (hbc : q.b < q.c) (hcd : q.c < q.d) :
    edgeDist boundary (q.leftEdge0 form) +
        edgeDist boundary (q.leftEdge1 form) <
      edgeDist boundary q.rightEdge0 +
        edgeDist boundary q.rightEdge1 := by
  cases form with
  | adjacentSides =>
      simpa [edgeDist, OrderedQuadData.leftEdge0,
        OrderedQuadData.leftEdge1, OrderedQuadData.rightEdge0,
        OrderedQuadData.rightEdge1] using
        (Problem97.CapCrossingKalmansonBridge.complementary_dist_add_dist_lt_diagonal_sum_of_ccw
            hA hinj himage hccw hab hbc hcd)
  | innerOuter =>
      simpa [edgeDist, OrderedQuadData.leftEdge0,
        OrderedQuadData.leftEdge1, OrderedQuadData.rightEdge0,
        OrderedQuadData.rightEdge1] using
        (Problem97.CapCrossingKalmansonBridge.dist_add_dist_lt_diagonal_sum_of_ccw
            hA hinj himage hccw hab hbc hcd)

/-- Checked row equalities cannot cancel the strict sides of two Kalmanson
inequalities against their diagonals.  This is cardinality-generic and consumes
only positive incidences from the recorded source rows. -/
theorem false_of_twoKalmansonCancellationData_of_check
    {A : Finset ℝ²} (hA : ConvexIndep A)
    {n : ℕ} {boundary : Fin n → ℝ²}
    (himage : Finset.univ.image boundary = A)
    (hccw : EuclideanGeometry.IsCcwConvexPolygon boundary)
    {P : RowPattern (Fin n)}
    (hreal : Realizes P boundary)
    (choices : List (RowChoice (Fin n)))
    (hpositive : PositiveRowsMatch P choices)
    (data : TwoKalmansonCancellationData (Fin n))
    (hcheck : data.check choices = true) : False := by
  simp only [TwoKalmansonCancellationData.check, Bool.and_eq_true,
    decide_eq_true_eq] at hcheck
  rcases hcheck with
    ⟨⟨⟨⟨⟨horder, hperm⟩, hpath0⟩, hpath1⟩, hpath2⟩, hpath3⟩
  rcases horder with ⟨hab1, hbc1, hcd1, hab2, hbc2, hcd2⟩
  have hlt1 := data.firstQuad.kalmanson_lt hA hreal.injective himage hccw
    data.firstForm hab1 hbc1 hcd1
  have hlt2 := data.secondQuad.kalmanson_lt hA hreal.injective himage hccw
    data.secondForm hab2 hbc2 hcd2
  let leftDist : Fin 4 → ℝ :=
    fun i => edgeDist boundary (data.leftEdge i)
  let rightDist : Fin 4 → ℝ :=
    fun i => edgeDist boundary (data.rightEdge i)
  have heq0 : leftDist 0 = rightDist (data.permutation.apply 0) :=
    EdgeClosure.sound hreal
      (edgeClosure_of_checkPath_positive hpositive data.path0 hpath0)
  have heq1 : leftDist 1 = rightDist (data.permutation.apply 1) :=
    EdgeClosure.sound hreal
      (edgeClosure_of_checkPath_positive hpositive data.path1 hpath1)
  have heq2 : leftDist 2 = rightDist (data.permutation.apply 2) :=
    EdgeClosure.sound hreal
      (edgeClosure_of_checkPath_positive hpositive data.path2 hpath2)
  have heq3 : leftDist 3 = rightDist (data.permutation.apply 3) :=
    EdgeClosure.sound hreal
      (edgeClosure_of_checkPath_positive hpositive data.path3 hpath3)
  have hsumPerm :
      (∑ i, leftDist i) =
        ∑ i, rightDist (data.permutation.apply i) := by
    simp only [Fin.sum_univ_four]
    rw [heq0, heq1, heq2, heq3]
  have hsum : (∑ i, leftDist i) = ∑ i, rightDist i :=
    hsumPerm.trans
      (data.permutation.sum_comp_eq_of_check rightDist hperm)
  have hlt : (∑ i, leftDist i) < ∑ i, rightDist i := by
    simp only [Fin.sum_univ_four]
    dsimp [leftDist, rightDist,
      TwoKalmansonCancellationData.leftEdge,
      TwoKalmansonCancellationData.rightEdge]
    linarith
  exact (ne_of_lt hlt) hsum

/-- One positively weighted strict Kalmanson inequality.  Repeating both
left-hand and both right-hand edges `weight` times turns a rational positive
linear certificate into a finite multiset certificate after clearing
denominators. -/
structure WeightedKalmansonTerm (α : Type*) where
  quad : OrderedQuadData α
  form : KalmansonForm
  weight : ℕ
deriving DecidableEq, Repr

def WeightedKalmansonTerm.leftEdges {α : Type*}
    (term : WeightedKalmansonTerm α) : List (Edge α) :=
  List.replicate term.weight (term.quad.leftEdge0 term.form) ++
    List.replicate term.weight (term.quad.leftEdge1 term.form)

def WeightedKalmansonTerm.rightEdges {α : Type*}
    (term : WeightedKalmansonTerm α) : List (Edge α) :=
  List.replicate term.weight term.quad.rightEdge0 ++
    List.replicate term.weight term.quad.rightEdge1

def WeightedKalmansonTerm.check {n : ℕ}
    (term : WeightedKalmansonTerm (Fin n)) : Bool :=
  decide (term.quad.a < term.quad.b ∧ term.quad.b < term.quad.c ∧
    term.quad.c < term.quad.d ∧ 0 < term.weight)

theorem WeightedKalmansonTerm.sum_lt
    {A : Finset ℝ²} (hA : ConvexIndep A)
    {n : ℕ} {boundary : Fin n → ℝ²}
    (hinj : Function.Injective boundary)
    (himage : Finset.univ.image boundary = A)
    (hccw : EuclideanGeometry.IsCcwConvexPolygon boundary)
    (term : WeightedKalmansonTerm (Fin n))
    (hcheck : term.check = true) :
    (term.leftEdges.map (edgeDist boundary)).sum <
      (term.rightEdges.map (edgeDist boundary)).sum := by
  simp only [WeightedKalmansonTerm.check, decide_eq_true_eq] at hcheck
  rcases hcheck with ⟨hab, hbc, hcd, hweight⟩
  have hlt := term.quad.kalmanson_lt hA hinj himage hccw term.form
    hab hbc hcd
  have hweightR : (0 : ℝ) < term.weight := Nat.cast_pos.mpr hweight
  simp only [WeightedKalmansonTerm.leftEdges,
    WeightedKalmansonTerm.rightEdges, List.map_append,
    List.map_replicate, List.sum_append, List.sum_replicate, nsmul_eq_mul]
  nlinarith

/-- One equality-closure pairing between a repeated left-hand distance and a
repeated right-hand distance. -/
structure WeightedEdgePairingData (α : Type*) where
  left : Edge α
  right : Edge α
  path : ClosurePathData α
deriving DecidableEq, Repr

/-- A checked finite positive linear cancellation of strict Kalmanson
inequalities.  The pairing lists must be permutations of the repeated left and
right edge multisets generated by the weighted terms. -/
structure WeightedKalmansonCancellationData (α : Type*) where
  terms : List (WeightedKalmansonTerm α)
  pairings : List (WeightedEdgePairingData α)
deriving DecidableEq, Repr

def WeightedKalmansonCancellationData.leftEdges {α : Type*}
    (data : WeightedKalmansonCancellationData α) : List (Edge α) :=
  data.terms.flatMap WeightedKalmansonTerm.leftEdges

def WeightedKalmansonCancellationData.rightEdges {α : Type*}
    (data : WeightedKalmansonCancellationData α) : List (Edge α) :=
  data.terms.flatMap WeightedKalmansonTerm.rightEdges

def WeightedKalmansonCancellationData.Valid {n : ℕ}
    (choices : List (RowChoice (Fin n)))
    (data : WeightedKalmansonCancellationData (Fin n)) : Prop :=
  data.terms ≠ [] ∧
  (∀ term ∈ data.terms, term.check = true) ∧
  (data.pairings.map WeightedEdgePairingData.left).Perm data.leftEdges ∧
  (data.pairings.map WeightedEdgePairingData.right).Perm data.rightEdges ∧
  ∀ pairing ∈ data.pairings,
    checkPath choices pairing.path pairing.left pairing.right = true

/-- Executable validity check for a finite positive weighted cancellation. -/
def WeightedKalmansonCancellationData.check {n : ℕ}
    (choices : List (RowChoice (Fin n)))
    (data : WeightedKalmansonCancellationData (Fin n)) : Bool :=
  decide (data.terms ≠ []) &&
  data.terms.all WeightedKalmansonTerm.check &&
  decide ((data.pairings.map WeightedEdgePairingData.left).Perm
    data.leftEdges) &&
  decide ((data.pairings.map WeightedEdgePairingData.right).Perm
    data.rightEdges) &&
  data.pairings.all (fun pairing =>
    checkPath choices pairing.path pairing.left pairing.right)

theorem WeightedKalmansonCancellationData.valid_of_check {n : ℕ}
    (choices : List (RowChoice (Fin n)))
    (data : WeightedKalmansonCancellationData (Fin n))
    (hcheck : data.check choices = true) : data.Valid choices := by
  simp only [WeightedKalmansonCancellationData.check,
    WeightedKalmansonCancellationData.Valid, Bool.and_eq_true,
    decide_eq_true_eq, List.all_eq_true] at hcheck ⊢
  rcases hcheck with ⟨⟨⟨⟨hne, hterms⟩, hleft⟩, hright⟩, hpairings⟩
  exact ⟨hne, hterms, hleft, hright, hpairings⟩

theorem sum_lt_of_weightedKalmansonTerms
    {A : Finset ℝ²} (hA : ConvexIndep A)
    {n : ℕ} {boundary : Fin n → ℝ²}
    (hinj : Function.Injective boundary)
    (himage : Finset.univ.image boundary = A)
    (hccw : EuclideanGeometry.IsCcwConvexPolygon boundary)
    (terms : List (WeightedKalmansonTerm (Fin n)))
    (hne : terms ≠ [])
    (hall : ∀ term ∈ terms, term.check = true) :
    (terms.flatMap WeightedKalmansonTerm.leftEdges |>.map
        (edgeDist boundary)).sum <
      (terms.flatMap WeightedKalmansonTerm.rightEdges |>.map
        (edgeDist boundary)).sum := by
  induction terms with
  | nil => exact (hne rfl).elim
  | cons head tail ih =>
      have hhead := head.sum_lt hA hinj himage hccw
        (hall head (by simp))
      by_cases htail : tail = []
      · subst tail
        simpa using hhead
      · have hrest := ih htail
          (fun term hterm => hall term (by simp [hterm]))
        simp only [List.flatMap_cons, List.map_append, List.sum_append]
        linarith

theorem sum_weightedEdgePairings_eq
    {n : ℕ} {boundary : Fin n → ℝ²} {P : RowPattern (Fin n)}
    (hreal : Realizes P boundary)
    (choices : List (RowChoice (Fin n)))
    (hpositive : PositiveRowsMatch P choices)
    (pairings : List (WeightedEdgePairingData (Fin n)))
    (hall : ∀ pairing ∈ pairings,
      checkPath choices pairing.path pairing.left pairing.right = true) :
    (pairings.map (fun pairing => edgeDist boundary pairing.left)).sum =
      (pairings.map (fun pairing => edgeDist boundary pairing.right)).sum := by
  induction pairings with
  | nil => simp
  | cons head tail ih =>
      have hhead : edgeDist boundary head.left =
          edgeDist boundary head.right :=
        EdgeClosure.sound hreal
          (edgeClosure_of_checkPath_positive hpositive head.path
            (hall head (by simp)))
      have htail := ih (fun pairing hpairing =>
        hall pairing (by simp [hpairing]))
      simp only [List.map_cons, List.sum_cons]
      rw [hhead, htail]

/-- Any checked nonempty positive linear combination of strict Kalmanson
inequalities whose repeated sides cancel through certified row equalities is
impossible.  This theorem is cardinality-generic and uses only positive row
incidences. -/
theorem false_of_weightedKalmansonCancellationData_of_check
    {A : Finset ℝ²} (hA : ConvexIndep A)
    {n : ℕ} {boundary : Fin n → ℝ²}
    (himage : Finset.univ.image boundary = A)
    (hccw : EuclideanGeometry.IsCcwConvexPolygon boundary)
    {P : RowPattern (Fin n)}
    (hreal : Realizes P boundary)
    (choices : List (RowChoice (Fin n)))
    (hpositive : PositiveRowsMatch P choices)
    (data : WeightedKalmansonCancellationData (Fin n))
    (hcheck : data.check choices = true) : False := by
  have hvalid : data.Valid choices := data.valid_of_check choices hcheck
  rcases hvalid with ⟨hne, hterms, hleft, hright, hpairings⟩
  have hlt := sum_lt_of_weightedKalmansonTerms hA hreal.injective
    himage hccw data.terms hne hterms
  have hpairingEq := sum_weightedEdgePairings_eq hreal choices hpositive
    data.pairings hpairings
  have hleftEq :
      (data.leftEdges.map (edgeDist boundary)).sum =
        (data.pairings.map
          (fun pairing => edgeDist boundary pairing.left)).sum := by
    symm
    simpa [Function.comp_def] using
      (hleft.map (edgeDist boundary)).sum_eq
  have hrightEq :
      (data.pairings.map
          (fun pairing => edgeDist boundary pairing.right)).sum =
        (data.rightEdges.map (edgeDist boundary)).sum := by
    simpa [Function.comp_def] using
      (hright.map (edgeDist boundary)).sum_eq
  have heq :
      (data.leftEdges.map (edgeDist boundary)).sum =
        (data.rightEdges.map (edgeDist boundary)).sum :=
    hleftEq.trans (hpairingEq.trans hrightEq)
  exact (ne_of_lt hlt) heq

/-- Proof-free duplicate-center core over an arbitrary finite label type. -/
structure DuplicateCenterData (α : Type*) where
  p : α
  q : α
  r : α
  a : α
  b : α
  ap_aq : ClosurePathData α
  ap_ar : ClosurePathData α
  bp_bq : ClosurePathData α
  bp_br : ClosurePathData α
deriving DecidableEq

def DuplicateCenterData.check {α : Type*} [DecidableEq α]
    (choices : List (RowChoice α)) (data : DuplicateCenterData α) : Bool :=
  decide (data.p ≠ data.q ∧ data.p ≠ data.r ∧
      data.q ≠ data.r ∧ data.a ≠ data.b) &&
    checkPath choices data.ap_aq (data.a, data.p) (data.a, data.q) &&
    checkPath choices data.ap_ar (data.a, data.p) (data.a, data.r) &&
    checkPath choices data.bp_bq (data.b, data.p) (data.b, data.q) &&
    checkPath choices data.bp_br (data.b, data.p) (data.b, data.r)

/-- A checked generic duplicate-center certificate yields the existing
proof-facing metric core. -/
theorem nonempty_duplicateCenterCore_of_check
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : RowsMatch P choices)
    (data : DuplicateCenterData α)
    (hcheck : data.check choices = true) : Nonempty (DuplicateCenterCore P) := by
  simp only [DuplicateCenterData.check, Bool.and_eq_true] at hcheck
  rcases hcheck with
    ⟨⟨⟨⟨hinequalities, hap_aq⟩, hap_ar⟩, hbp_bq⟩, hbp_br⟩
  have hne : data.p ≠ data.q ∧ data.p ≠ data.r ∧
      data.q ≠ data.r ∧ data.a ≠ data.b :=
    of_decide_eq_true hinequalities
  exact ⟨{
    p := data.p
    q := data.q
    r := data.r
    a := data.a
    b := data.b
    hpq := hne.1
    hpr := hne.2.1
    hqr := hne.2.2.1
    hab := hne.2.2.2
    ap_aq := edgeClosure_of_checkPath hrows data.ap_aq hap_aq
    ap_ar := edgeClosure_of_checkPath hrows data.ap_ar hap_ar
    bp_bq := edgeClosure_of_checkPath hrows data.bp_bq hbp_bq
    bp_br := edgeClosure_of_checkPath hrows data.bp_br hbp_br }⟩

/-- A duplicate-center certificate remains sound when its row choices record
only the positive memberships actually traversed by its closure paths. -/
theorem nonempty_duplicateCenterCore_of_positiveCheck
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {choices : List (RowChoice α)} (hrows : PositiveRowsMatch P choices)
    (data : DuplicateCenterData α)
    (hcheck : data.check choices = true) : Nonempty (DuplicateCenterCore P) := by
  simp only [DuplicateCenterData.check, Bool.and_eq_true] at hcheck
  rcases hcheck with
    ⟨⟨⟨⟨hinequalities, hap_aq⟩, hap_ar⟩, hbp_bq⟩, hbp_br⟩
  have hne : data.p ≠ data.q ∧ data.p ≠ data.r ∧
      data.q ≠ data.r ∧ data.a ≠ data.b :=
    of_decide_eq_true hinequalities
  exact ⟨{
    p := data.p
    q := data.q
    r := data.r
    a := data.a
    b := data.b
    hpq := hne.1
    hpr := hne.2.1
    hqr := hne.2.2.1
    hab := hne.2.2.2
    ap_aq := edgeClosure_of_checkPath_positive hrows data.ap_aq hap_aq
    ap_ar := edgeClosure_of_checkPath_positive hrows data.ap_ar hap_ar
    bp_bq := edgeClosure_of_checkPath_positive hrows data.bp_bq hbp_bq
    bp_br := edgeClosure_of_checkPath_positive hrows data.bp_br hbp_br }⟩

/-- Transport a duplicate-center core from finite labels back to the carrier
labels represented by those finite labels. -/
theorem nonempty_duplicateCenterCore_of_reindexRowPattern
    {α β : Type*} [DecidableEq β] (e : α ≃ β) {P : RowPattern α}
    (hcore : Nonempty (DuplicateCenterCore (reindexRowPattern e P))) :
    Nonempty (DuplicateCenterCore P) := by
  rcases hcore with ⟨core⟩
  exact ⟨{
    p := e.symm core.p
    q := e.symm core.q
    r := e.symm core.r
    a := e.symm core.a
    b := e.symm core.b
    hpq := fun h => core.hpq (e.symm.injective h)
    hpr := fun h => core.hpr (e.symm.injective h)
    hqr := fun h => core.hqr (e.symm.injective h)
    hab := fun h => core.hab (e.symm.injective h)
    ap_aq := edgeClosure_of_reindexRowPattern e core.ap_aq
    ap_ar := edgeClosure_of_reindexRowPattern e core.ap_ar
    bp_bq := edgeClosure_of_reindexRowPattern e core.bp_bq
    bp_br := edgeClosure_of_reindexRowPattern e core.bp_br }⟩

/-- Combined checker and relabeling theorem for a finite duplicate-center
certificate. -/
theorem nonempty_duplicateCenterCore_of_reindexed_check
    {α β : Type*} [DecidableEq β] (e : α ≃ β) {P : RowPattern α}
    {choices : List (RowChoice β)}
    (hrows : RowsMatch (reindexRowPattern e P) choices)
    (data : DuplicateCenterData β) (hcheck : data.check choices = true) :
    Nonempty (DuplicateCenterCore P) :=
  nonempty_duplicateCenterCore_of_reindexRowPattern e
    (nonempty_duplicateCenterCore_of_check hrows data hcheck)

/-- A proof-free learned nogood packages the exact rows used by a
duplicate-center record together with its closure witness.  Validity remains a
closed Boolean check; the package contains no theorem field. -/
structure DuplicateCenterNogood (α : Type*) where
  choices : List (RowChoice α)
  data : DuplicateCenterData α
deriving DecidableEq

/-- Closed validity check for one learned duplicate-center nogood. -/
def DuplicateCenterNogood.check {α : Type*} [DecidableEq α]
    (nogood : DuplicateCenterNogood α) : Bool :=
  nogood.data.check nogood.choices

/-- Semantic coverage of a row pattern by one learned nogood. -/
def DuplicateCenterNogood.Matches {α : Type*}
    (nogood : DuplicateCenterNogood α) (P : RowPattern α) : Prop :=
  RowsMatch P nogood.choices

/-- Positive-incidence semantics of one learned duplicate-center nogood. -/
def DuplicateCenterNogood.PositivelyMatches {α : Type*}
    (nogood : DuplicateCenterNogood α) (P : RowPattern α) : Prop :=
  PositiveRowsMatch P nogood.choices

/-- Closed row-arity side condition used to turn positive incidence data into
exact rows on an exact-four source pattern. -/
def DuplicateCenterNogood.FourSupported {α : Type*}
    (nogood : DuplicateCenterNogood α) : Prop :=
  FourSupportedRows nogood.choices

/-- Executable form of the four-positive-incidence side condition. -/
def DuplicateCenterNogood.fourSupportedCheck {α : Type*} [DecidableEq α]
    (nogood : DuplicateCenterNogood α) : Bool :=
  nogood.choices.all fun choice => decide (choice.support.card = 4)

theorem DuplicateCenterNogood.fourSupported_of_check
    {α : Type*} [DecidableEq α] (nogood : DuplicateCenterNogood α)
    (hcheck : nogood.fourSupportedCheck = true) :
    nogood.FourSupported := by
  intro choice hchoice
  have hall := List.all_eq_true.mp hcheck
  exact of_decide_eq_true (hall choice hchoice)

/-- A valid matching learned nogood rules out an injective planar
realization. -/
theorem DuplicateCenterNogood.not_realizes_of_check
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    (nogood : DuplicateCenterNogood α)
    (hcheck : nogood.check = true) (hmatches : nogood.Matches P) :
    ¬ (∃ pointOf : α → ℝ², Realizes P pointOf) := by
  rcases nonempty_duplicateCenterCore_of_check hmatches nogood.data hcheck with
    ⟨core⟩
  exact not_realizes_of_duplicateCenterCore core

/-- A valid duplicate-center nogood needs only the positive memberships named
by its checked closure paths. -/
theorem DuplicateCenterNogood.not_realizes_of_positiveCheck
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    (nogood : DuplicateCenterNogood α)
    (hcheck : nogood.check = true)
    (hmatches : nogood.PositivelyMatches P) :
    ¬ (∃ pointOf : α → ℝ², Realizes P pointOf) := by
  rcases nonempty_duplicateCenterCore_of_positiveCheck hmatches nogood.data
      hcheck with ⟨core⟩
  exact not_realizes_of_duplicateCenterCore core

/-- Semantic coverage of a row pattern by a finite bank of learned
duplicate-center nogoods. -/
def DuplicateCenterBankCovers {α : Type*}
    (bank : List (DuplicateCenterNogood α)) (P : RowPattern α) : Prop :=
  ∃ nogood ∈ bank, nogood.Matches P

/-- Soundness boundary for a finite bank.  This theorem checks only
duplicate-center record validity and consumes a separately proved semantic
coverage statement; it does not claim that a SAT journal is exhaustive. -/
theorem not_realizes_of_duplicateCenterBank
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {bank : List (DuplicateCenterNogood α)}
    (hvalid : ∀ nogood ∈ bank, nogood.check = true)
    (hcoverage : DuplicateCenterBankCovers bank P) :
    ¬ (∃ pointOf : α → ℝ², Realizes P pointOf) := by
  rcases hcoverage with ⟨nogood, hmem, hmatches⟩
  exact nogood.not_realizes_of_check (hvalid nogood hmem) hmatches

/-- Positive-incidence coverage by a finite bank.  This is the source-faithful
semantics of journals whose rows are marked `exact := false`. -/
def PositiveDuplicateCenterBankCovers {α : Type*}
    (bank : List (DuplicateCenterNogood α)) (P : RowPattern α) : Prop :=
  ∃ nogood ∈ bank, nogood.PositivelyMatches P

/-- Cardinality-free soundness for membership-core banks.  Unlike the older
exact-four adapter below, this theorem does not require a recorded support to
exhaust the source row. -/
theorem not_realizes_of_positiveDuplicateCenterBank_noCardinality
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {bank : List (DuplicateCenterNogood α)}
    (hvalid : ∀ nogood ∈ bank, nogood.check = true)
    (hcoverage : PositiveDuplicateCenterBankCovers bank P) :
    ¬ (∃ pointOf : α → ℝ², Realizes P pointOf) := by
  rcases hcoverage with ⟨nogood, hmem, hpositive⟩
  exact nogood.not_realizes_of_positiveCheck (hvalid nogood hmem) hpositive

/-- An exact-four row pattern is ruled out by a valid four-supported bank as
soon as one journal nogood positively matches it. -/
theorem not_realizes_of_positiveDuplicateCenterBank
    {α : Type*} [DecidableEq α] {P : RowPattern α}
    {bank : List (DuplicateCenterNogood α)}
    (hsource : ∀ center, (P center).card = 4)
    (hvalid : ∀ nogood ∈ bank, nogood.check = true)
    (hfour : ∀ nogood ∈ bank, nogood.FourSupported)
    (hcoverage : PositiveDuplicateCenterBankCovers bank P) :
    ¬ (∃ pointOf : α → ℝ², Realizes P pointOf) := by
  rcases hcoverage with ⟨nogood, hmem, hpositive⟩
  apply nogood.not_realizes_of_check (hvalid nogood hmem)
  exact rowsMatch_of_positiveRowsMatch_of_card_eq_four hpositive hsource
    (hfour nogood hmem)

end GenericRowNogoodCertificate
