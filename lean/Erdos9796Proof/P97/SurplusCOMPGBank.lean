      let x := pointPair.fst
      let y := pointPair.snd
      if x == c || x == cp || y == c || y == cp then
        true
      else if maskHas cmask x && maskHas cmask y &&
          maskHas cpmask x && maskHas cpmask y then
        separated c cp x y
      else
