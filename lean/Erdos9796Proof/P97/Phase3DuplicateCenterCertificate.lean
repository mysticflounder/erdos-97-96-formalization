import Erdos9796Proof.P97.Census554.EqualityCore

/-!
# Checked duplicate-center certificates on ten labels

This module is the proof-facing checker for the saved bounded Phase-3
`(k,n,profile) = (4,10,(4,4,5))` SAT witness census.  A certificate is only a
finite path in the equality closure generated by row equalities and edge
reversal.  The external emitter is not trusted: successful reduction of
`DuplicateCenterCertificate.check` produces the existing generic
`DuplicateCenterCore`.

This file deliberately says nothing about completeness of the bounded SAT
census and does not connect its rows to a live `FaithfulCarrierPattern`.
-/

namespace Problem97
namespace Phase3DuplicateCenterCertificate

open Census554.EqualityCore
open scoped EuclideanGeometry

/-- The fixed label type of the bounded Phase-3 source records. -/
abbrev Label := Fin 10

/-- A primitive proof-free equality-closure step. -/
inductive PrimitiveEqualityStep where
  /-- Two edges from one center whose endpoints occur in the same row. -/
  | row (center first second : Label)
  /-- Reverse an oriented edge. -/
  | flip (first second : Label)
deriving DecidableEq, Repr

def PrimitiveEqualityStep.source :
    PrimitiveEqualityStep → Edge Label
  | .row center first _ => (center, first)
  | .flip first second => (first, second)

def PrimitiveEqualityStep.target :
    PrimitiveEqualityStep → Edge Label
  | .row center _ second => (center, second)
  | .flip first second => (second, first)

/-- Executably validate one primitive step against a concrete row pattern. -/
def PrimitiveEqualityStep.check
    (P : RowPattern Label) : PrimitiveEqualityStep → Bool
  | .row center first second =>
      decide (first ∈ P center) && decide (second ∈ P center)
  | .flip _ _ => true

/-- Soundness of the primitive-step checker. -/
theorem PrimitiveEqualityStep.edgeClosure_of_check
    {P : RowPattern Label} (step : PrimitiveEqualityStep)
    (hcheck : step.check P = true) :
    EdgeClosure P step.source step.target := by
  cases step with
  | row center first second =>
      simp only [PrimitiveEqualityStep.check, Bool.and_eq_true,
        decide_eq_true_eq] at hcheck
      exact EdgeClosure.row center first second hcheck.1 hcheck.2
  | flip first second =>
      exact EdgeClosure.flip first second

/-- Check that a list of primitive steps is a composable path. -/
def checkStepChain (P : RowPattern Label) :
    Edge Label → List PrimitiveEqualityStep → Edge Label → Bool
  | first, [], last => decide (first = last)
  | first, step :: steps, last =>
      decide (first = step.source) && step.check P &&
        checkStepChain P step.target steps last

/-- Soundness of a checked primitive-step chain. -/
theorem edgeClosure_of_checkStepChain
    {P : RowPattern Label} {first last : Edge Label}
    {steps : List PrimitiveEqualityStep}
    (hcheck : checkStepChain P first steps last = true) :
    EdgeClosure P first last := by
  induction steps generalizing first with
  | nil =>
      simp only [checkStepChain, decide_eq_true_eq] at hcheck
      subst last
      exact EdgeClosure.refl first
  | cons step steps ih =>
      simp only [checkStepChain, Bool.and_eq_true,
        decide_eq_true_eq] at hcheck
      rcases hcheck with ⟨⟨hfirst, hstep⟩, htail⟩
      subst first
      exact EdgeClosure.trans
        (step.edgeClosure_of_check hstep) (ih htail)

/-- Proof-free data for a closure path with recorded endpoints. -/
structure ClosurePathData where
  first : Edge Label
  last : Edge Label
  steps : List PrimitiveEqualityStep
deriving DecidableEq, Repr

/-- Check a path's endpoints and all its primitive steps. -/
def ClosurePathData.check
    (P : RowPattern Label) (path : ClosurePathData)
    (first last : Edge Label) : Bool :=
  (decide (path.first = first) && decide (path.last = last)) &&
    checkStepChain P path.first path.steps path.last

/-- A checked path yields the equality closure between its prescribed edges. -/
theorem ClosurePathData.edgeClosure_of_check
    {P : RowPattern Label} (path : ClosurePathData)
    {first last : Edge Label}
    (hcheck : path.check P first last = true) :
    EdgeClosure P first last := by
  simp only [ClosurePathData.check, Bool.and_eq_true,
    decide_eq_true_eq] at hcheck
  rcases hcheck with ⟨⟨hfirst, hlast⟩, hsteps⟩
  subst first
  subst last
  exact edgeClosure_of_checkStepChain hsteps

/-- Proof-free duplicate-center core for one ten-label row pattern. -/
structure DuplicateCenterCertificate where
  p : Label
  q : Label
  r : Label
  a : Label
  b : Label
  ap_aq : ClosurePathData
  ap_ar : ClosurePathData
  bp_bq : ClosurePathData
  bp_br : ClosurePathData
deriving DecidableEq, Repr

/-- Closed validation of every side condition and closure path. -/
def DuplicateCenterCertificate.check
    (P : RowPattern Label) (cert : DuplicateCenterCertificate) : Bool :=
  decide (cert.p ≠ cert.q ∧ cert.p ≠ cert.r ∧
      cert.q ≠ cert.r ∧ cert.a ≠ cert.b) &&
    cert.ap_aq.check P (cert.a, cert.p) (cert.a, cert.q) &&
    cert.ap_ar.check P (cert.a, cert.p) (cert.a, cert.r) &&
    cert.bp_bq.check P (cert.b, cert.p) (cert.b, cert.q) &&
    cert.bp_br.check P (cert.b, cert.p) (cert.b, cert.r)

/-- The finite checker constructs the generic proof-facing duplicate-center
core. -/
def DuplicateCenterCertificate.duplicateCenterCoreOfCheck
    {P : RowPattern Label} (cert : DuplicateCenterCertificate)
    (hcheck : cert.check P = true) :
    DuplicateCenterCore P := by
  simp only [DuplicateCenterCertificate.check, Bool.and_eq_true,
    decide_eq_true_eq] at hcheck
  rcases hcheck with
    ⟨⟨⟨⟨hne, hap_aq⟩, hap_ar⟩, hbp_bq⟩, hbp_br⟩
  exact {
    p := cert.p
    q := cert.q
    r := cert.r
    a := cert.a
    b := cert.b
    hpq := hne.1
    hpr := hne.2.1
    hqr := hne.2.2.1
    hab := hne.2.2.2
    ap_aq := cert.ap_aq.edgeClosure_of_check hap_aq
    ap_ar := cert.ap_ar.edgeClosure_of_check hap_ar
    bp_bq := cert.bp_bq.edgeClosure_of_check hbp_bq
    bp_br := cert.bp_br.edgeClosure_of_check hbp_br
  }

/-- Propositional form of checker soundness. -/
theorem DuplicateCenterCertificate.nonempty_duplicateCenterCore_of_check
    {P : RowPattern Label} (cert : DuplicateCenterCertificate)
    (hcheck : cert.check P = true) :
    Nonempty (DuplicateCenterCore P) :=
  ⟨cert.duplicateCenterCoreOfCheck hcheck⟩

/-- A successfully checked certificate rules out an injective planar
realization of its concrete row pattern. -/
theorem DuplicateCenterCertificate.not_realizes_of_check
    {P : RowPattern Label} (cert : DuplicateCenterCertificate)
    (hcheck : cert.check P = true) :
    ¬ ∃ pointOf : Label → ℝ², Realizes P pointOf :=
  not_realizes_of_duplicateCenterCore
    (cert.duplicateCenterCoreOfCheck hcheck)

end Phase3DuplicateCenterCertificate
end Problem97
