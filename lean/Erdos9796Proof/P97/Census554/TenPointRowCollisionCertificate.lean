/-- The coordinate valuation for the eight free normalized points. -/
def coordinateValuation (q : Fin 10 → ℝ²) : ℕ → ℝ
  | 0 => q 2 0
  | 1 => q 2 1
  | 2 => q 3 0
  | 3 => q 3 1
  | 4 => q 4 0
  | 5 => q 4 1
  | 6 => q 5 0
  | 7 => q 5 1
  | 8 => q 6 0
  | 9 => q 6 1
  | 10 => q 7 0
  | 11 => q 7 1
  | 12 => q 8 0
  | 13 => q 8 1
  | 14 => q 9 0
  | 15 => q 9 1
  | _ => 0

/-- Variable number of the x-coordinate of a free point. -/
def freeX (i : Fin 10) : ℕ := 2 * (i.1 - 2)

/-- Variable number of the y-coordinate of a free point. -/
def freeY (i : Fin 10) : ℕ := freeX i + 1

/-- Squared-distance polynomial in the normal-axis gauge. -/
def squaredDistancePolynomial (i j : Fin 10) : SparsePoly :=
  if i = 0 then
    if j = 0 then [] else
    if j = 1 then onePoly else coordSqNormPoly (freeX j) (freeY j)
  else if j = 0 then
    if i = 1 then onePoly else coordSqNormPoly (freeX i) (freeY i)
  else if i = 1 then
    if j = 1 then [] else coordSqDistUnitXPoly (freeX j) (freeY j)
  else if j = 1 then
    coordSqDistUnitXPoly (freeX i) (freeY i)
  else
    coordSqDistPoly (freeX i) (freeY i) (freeX j) (freeY j)

/-- Evaluation of the gauge polynomial is coordinate squared distance. -/
theorem eval_squaredDistancePolynomial (q : Fin 10 → ℝ²)
    (hq0 : q 0 = 0) (hq1 : q 1 = !₂[(1 : ℝ), 0]) (i j : Fin 10) :
    eval (coordinateValuation q) (squaredDistancePolynomial i j) =
      coordSqDist (q i) (q j) := by
  fin_cases i <;> fin_cases j <;>
    simp [squaredDistancePolynomial, freeX, freeY, coordinateValuation,
      eval_onePoly, eval_coordSqNormPoly, eval_coordSqDistUnitXPoly,
      eval_coordSqDistPoly, coordSqDist, hq0, hq1] <;> ring

/-- A polynomial recording equality of two distances from the same center. -/
def distanceEqualityPolynomial (center first second : Fin 10) : SparsePoly :=
  squaredDistancePolynomial center first ++
    neg (squaredDistancePolynomial center second)

/-- An equal-distance coordinate fact zeros its equality polynomial. -/
theorem eval_distanceEqualityPolynomial_eq_zero
    (q : Fin 10 → ℝ²) (hq0 : q 0 = 0) (hq1 : q 1 = !₂[(1 : ℝ), 0])
    (center first second : Fin 10)
    (h : coordSqDist (q center) (q first) =
      coordSqDist (q center) (q second)) :
    eval (coordinateValuation q)
      (distanceEqualityPolynomial center first second) = 0 := by
  rw [distanceEqualityPolynomial, eval_append, eval_neg,
    eval_squaredDistancePolynomial q hq0 hq1,
    eval_squaredDistancePolynomial q hq0 hq1]
  linarith

