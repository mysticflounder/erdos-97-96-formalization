    (a z1x z1y z2x z2y z3x z3y : ℝ) : Prop :=
  branch_mmmmm a z1x z1y z2x z2y z3x z3y ∨
    branch_mmmmp a z1x z1y z2x z2y z3x z3y ∨
    branch_mmmpm a z1x z1y z2x z2y z3x z3y ∨
    branch_mmmpp a z1x z1y z2x z2y z3x z3y ∨
